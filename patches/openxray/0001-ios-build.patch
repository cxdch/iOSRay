+void gl_Clear(GLbitfield mask)
+{
+    const PassTargets t = CurrentTargets();
+    if (t.empty)
+        return;
+    // Очищаем загрузкой прохода. Scissor при этом не учитывается (пока).
+    BeginPass(t, mask);
+}
