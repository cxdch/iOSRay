diff --git a/src/xr_3da/ios_bootstrap.mm b/src/xr_3da/ios_bootstrap.mm
new file mode 100644
index 00000000..072c8893
--- /dev/null
+++ b/src/xr_3da/ios_bootstrap.mm
@@ -0,0 +1,153 @@
+// iOSRay: подготовка окружения движка на iOS перед entry_point().
+//
+// Что делает:
+//  1. Перенаправляет stdout/stderr в Documents/iosray-console.log — это первый лог,
+//     который пишется ещё до инициализации файловой системы движка.
+//  2. Выбирает папку игры в Documents (видна в приложении «Файлы»):
+//       Documents/soc — Тень Чернобыля (-shoc), Documents/cs — Чистое Небо (-cs),
+//       Documents/cop — Зов Припяти. Если папок нет, создаёт soc с инструкцией.
+//  3. Кладёт в папку игры fsgame.ltx из бандла (если там нет своего) и ссылку
+//     gamedata/shaders/gl на шейдеры OpenXRay из бандла.
+//  4. Делает папку игры текущей: LocatorAPI ищет fsgame.ltx в текущем каталоге.
+
+#import <Foundation/Foundation.h>
+#include <unistd.h>
+#include <stdio.h>
+#include <string>
+#include <sys/stat.h>
+
+namespace
+{
+NSString* Documents()
+{
+    return NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES).firstObject;
+}
+
+void RedirectConsole(NSString* docs)
+{
+    NSString* path = [docs stringByAppendingPathComponent:@"iosray-console.log"];
+    freopen(path.fileSystemRepresentation, "w", stdout);
+    setvbuf(stdout, nullptr, _IOLBF, 0);
+    dup2(fileno(stdout), fileno(stderr));
+    setvbuf(stderr, nullptr, _IONBF, 0);
+    NSDictionary* info = NSBundle.mainBundle.infoDictionary;
+    printf("[iOSRay] %s %s, %s\n", [info[@"CFBundleName"] UTF8String],
+           [info[@"CFBundleShortVersionString"] UTF8String], [NSProcessInfo.processInfo.operatingSystemVersionString UTF8String]);
+}
+
+void EnsureLink(NSString* link, NSString* target)
+{
+    NSFileManager* fm = NSFileManager.defaultManager;
+    NSString* current = [fm destinationOfSymbolicLinkAtPath:link error:nil];
+    if ([current isEqualToString:target])
+        return;
+    // Путь к бандлу меняется после каждой переустановки — пересоздаём ссылку.
+    if (current || [fm fileExistsAtPath:link])
+    {
+        BOOL isDir = NO;
+        [fm fileExistsAtPath:link isDirectory:&isDir];
+        if (current || !isDir)
+            [fm removeItemAtPath:link error:nil];
+        else
+        {
+            printf("[iOSRay] %s — настоящая папка, ссылку не создаю\n", link.fileSystemRepresentation);
+            return;
+        }
+    }
+    [fm createDirectoryAtPath:link.stringByDeletingLastPathComponent withIntermediateDirectories:YES attributes:nil error:nil];
+    NSError* err = nil;
+    if (![fm createSymbolicLinkAtPath:link withDestinationPath:target error:&err])
+        printf("[iOSRay] не удалось создать ссылку %s: %s\n", link.fileSystemRepresentation, err.localizedDescription.UTF8String);
+}
+} // namespace
+
+// Возвращает добавку к командной строке движка (например, "-shoc ").
+extern "C" void xr_ios_touch_start();
+
+extern "C" const char* xr_ios_prepare()
+{
+    static std::string extraArgs;
+    @autoreleasepool
+    {
+        NSString* docs = Documents();
+        RedirectConsole(docs);
+        NSFileManager* fm = NSFileManager.defaultManager;
+
+        struct Game { NSString* folder; const char* args; const char* title; };
+        const Game games[] = {
+            { @"soc", "-shoc ", "Тень Чернобыля" },
+            { @"cs", "-cs ", "Чистое Небо" },
+            { @"cop", "", "Зов Припяти" },
+        };
+        const Game* chosen = nullptr;
+        for (const Game& g : games)
+        {
+            BOOL isDir = NO;
+            if ([fm fileExistsAtPath:[docs stringByAppendingPathComponent:g.folder] isDirectory:&isDir] && isDir)
+            {
+                chosen = &g;
+                break;
+            }
+        }
+        if (!chosen)
+        {
+            chosen = &games[0];
+            NSString* dir = [docs stringByAppendingPathComponent:chosen->folder];
+            [fm createDirectoryAtPath:dir withIntermediateDirectories:YES attributes:nil error:nil];
+            NSString* readme =
+                @"Скопируйте сюда файлы S.T.A.L.K.E.R.: Тень Чернобыля 1.0006 из своей лицензионной копии\n"
+                 "(архивы gamedata.db*, папки levels/localization/resources, если есть).\n"
+                 "Папки cs и cop рядом — для Чистого Неба и Зова Припяти.\n";
+            [readme writeToFile:[dir stringByAppendingPathComponent:@"ПОЛОЖИТЕ_ИГРУ_СЮДА.txt"]
+                     atomically:YES encoding:NSUTF8StringEncoding error:nil];
+        }
+
+        NSString* gameDir = [docs stringByAppendingPathComponent:chosen->folder];
+        NSString* res = [NSBundle.mainBundle.resourcePath stringByAppendingPathComponent:@"res"];
+        printf("[iOSRay] игра: %s, папка: %s\n", chosen->title, gameDir.fileSystemRepresentation);
+
+        NSString* fsltx = [gameDir stringByAppendingPathComponent:@"fsgame.ltx"];
+        if (![fm fileExistsAtPath:fsltx])
+        {
+            [fm copyItemAtPath:[res stringByAppendingPathComponent:@"fsgame.ltx"] toPath:fsltx error:nil];
+            printf("[iOSRay] fsgame.ltx скопирован из бандла\n");
+        }
+        else
+        {
+            // fsgame.ltx с ПК: пути вида C:\... на iPhone не работают. Строки с буквой диска
+            // заменяем на путь внутри папки игры, оригинал сохраняем в fsgame.ltx.pc.
+            NSString* text = [NSString stringWithContentsOfFile:fsltx encoding:NSWindowsCP1251StringEncoding error:nil];
+            if (text)
+            {
+                NSRegularExpression* drive = [NSRegularExpression
+                    regularExpressionWithPattern:@"^(\\s*\\$app_data_root\\$\\s*=).*\\b[A-Za-z]:\\\\.*$"
+                    options:NSRegularExpressionAnchorsMatchLines error:nil];
+                NSString* fixed = [drive stringByReplacingMatchesInString:text options:0
+                    range:NSMakeRange(0, text.length)
+                    withTemplate:@"$1 true| false| \\$fs_root\\$| _appdata_\\\\"];
+                if (![fixed isEqualToString:text])
+                {
+                    NSString* backup = [fsltx stringByAppendingString:@".pc"];
+                    if (![fm fileExistsAtPath:backup])
+                        [fm copyItemAtPath:fsltx toPath:backup error:nil];
+                    [fixed writeToFile:fsltx atomically:YES encoding:NSWindowsCP1251StringEncoding error:nil];
+                    printf("[iOSRay] fsgame.ltx: $app_data_root$ перенесён в папку игры (_appdata_), оригинал — fsgame.ltx.pc\n");
+                }
+            }
+        }
+        NSString* perf = [gameDir stringByAppendingPathComponent:@"iosray.ltx"];
+        if (![fm fileExistsAtPath:perf])
+        {
+            [fm copyItemAtPath:[res stringByAppendingPathComponent:@"iosray.ltx"] toPath:perf error:nil];
+            printf("[iOSRay] iosray.ltx (настройки графики) скопирован из бандла\n");
+        }
+        EnsureLink([gameDir stringByAppendingPathComponent:@"gamedata/shaders/gl"],
+                   [res stringByAppendingPathComponent:@"gamedata/shaders/gl"]);
+
+        chdir(gameDir.fileSystemRepresentation);
+        xr_ios_touch_start(); // экранное управление появится, когда SDL создаст окно
+        extraArgs = chosen->args;
+        fflush(stdout);
+    }
+    return extraArgs.c_str();
+}
diff --git a/src/xr_3da/ios_touch.mm b/src/xr_3da/ios_touch.mm
new file mode 100644
index 00000000..c873e5d7
--- /dev/null
+++ b/src/xr_3da/ios_touch.mm
@@ -0,0 +1,343 @@
+// iOSRay: экранное управление поверх окна SDL (минимальный набор).
+//
+//  * В игре (движок захватил ввод) слой ловит все касания:
+//      левая часть экрана — плавающий стик (W/A/S/D через привязки действий),
+//      правая часть — обзор (относительное движение мыши),
+//      кнопки — действия: огонь, прицел, прыжок, присед, использовать,
+//      перезарядка, инвентарь.
+//  * В меню слой пропускает касания к SDL (там они работают как мышь),
+//    видна только кнопка «Меню» (Esc) в правом верхнем углу.
+//
+// Кнопки не знают клавиш: движок сам ищет, на что назначено действие
+// (xr_ios_action в xrEngine/xr_input.cpp).
+
+#import <UIKit/UIKit.h>
+#import <QuartzCore/QuartzCore.h>
+
+extern "C" int xr_ios_input_grabbed();
+extern "C" void xr_ios_action(int iosAction, int down);
+extern "C" void xr_ios_look(int dx, int dy);
+
+namespace
+{
+enum IosAction
+{
+    actFwd = 0, actBack, actLeft, actRight,
+    actFire, actAim, actJump, actCrouch,
+    actUse, actReload, actInventory, actMenu,
+};
+
+constexpr CGFloat kStickZone = 0.40;      // доля ширины экрана слева под стик
+constexpr CGFloat kStickDeadZone = 14.0;  // пт
+constexpr CGFloat kLookScale = 2.2;       // пикселей «мыши» на пункт касания
+} // namespace
+
+@interface XRTouchButton : UIButton
+@property(nonatomic) int action;
+@property(nonatomic) BOOL alwaysVisible;
+@end
+
+@implementation XRTouchButton
+@end
+
+@interface XRTouchOverlay : UIView
+@property(nonatomic) BOOL gameplay;
+@end
+
+@implementation XRTouchOverlay
+{
+    UITouch* _stickTouch;
+    UITouch* _lookTouch;
+    CGPoint _stickOrigin;
+    CGPoint _lookLast;
+    float _lookRemX, _lookRemY;
+    bool _dir[4];
+    UIView* _stickBase;
+    UIView* _stickKnob;
+    NSMutableArray<XRTouchButton*>* _buttons;
+}
+
+- (instancetype)initWithFrame:(CGRect)frame
+{
+    if ((self = [super initWithFrame:frame]))
+    {
+        self.backgroundColor = UIColor.clearColor;
+        self.multipleTouchEnabled = YES;
+        self.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+        _buttons = [NSMutableArray array];
+
+        _stickBase = [self circleWithSize:120 alpha:0.18];
+        _stickKnob = [self circleWithSize:54 alpha:0.35];
+        _stickBase.hidden = _stickKnob.hidden = YES;
+
+        [self addButton:@"ЛКМ" action:actFire size:86];
+        [self addButton:@"ПКМ" action:actAim size:62];
+        [self addButton:@"Space" action:actJump size:58];
+        [self addButton:@"Ctrl" action:actCrouch size:58];
+        [self addButton:@"F" action:actUse size:54];
+        [self addButton:@"R" action:actReload size:54];
+        [self addButton:@"I" action:actInventory size:50];
+        XRTouchButton* menu = [self addButton:@"Esc" action:actMenu size:46];
+        menu.alwaysVisible = YES;
+        _gameplay = YES;
+        self.gameplay = NO;
+    }
+    return self;
+}
+
+- (UIView*)circleWithSize:(CGFloat)size alpha:(CGFloat)alpha
+{
+    UIView* v = [[UIView alloc] initWithFrame:CGRectMake(0, 0, size, size)];
+    v.backgroundColor = [UIColor colorWithWhite:1.0 alpha:alpha];
+    v.layer.cornerRadius = size / 2;
+    v.userInteractionEnabled = NO;
+    [self addSubview:v];
+    return v;
+}
+
+- (XRTouchButton*)addButton:(NSString*)title action:(int)action size:(CGFloat)size
+{
+    XRTouchButton* b = [XRTouchButton buttonWithType:UIButtonTypeCustom];
+    b.action = action;
+    b.frame = CGRectMake(0, 0, size, size);
+    b.layer.cornerRadius = size / 2;
+    b.layer.borderWidth = 1.5;
+    b.layer.borderColor = [UIColor colorWithWhite:1.0 alpha:0.45].CGColor;
+    b.backgroundColor = [UIColor colorWithWhite:0.0 alpha:0.28];
+    [b setTitle:title forState:UIControlStateNormal];
+    [b setTitleColor:[UIColor colorWithWhite:1.0 alpha:0.85] forState:UIControlStateNormal];
+    b.titleLabel.font = [UIFont boldSystemFontOfSize:size > 70 ? 17 : 14];
+    b.titleLabel.adjustsFontSizeToFitWidth = YES;
+    b.exclusiveTouch = NO;
+    [b addTarget:self action:@selector(buttonDown:) forControlEvents:UIControlEventTouchDown];
+    [b addTarget:self action:@selector(buttonUp:)
+        forControlEvents:UIControlEventTouchUpInside | UIControlEventTouchUpOutside | UIControlEventTouchCancel];
+    [self addSubview:b];
+    [_buttons addObject:b];
+    return b;
+}
+
+- (void)buttonDown:(XRTouchButton*)b
+{
+    b.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.30];
+    xr_ios_action(b.action, 1);
+}
+
+- (void)buttonUp:(XRTouchButton*)b
+{
+    b.backgroundColor = [UIColor colorWithWhite:0.0 alpha:0.28];
+    xr_ios_action(b.action, 0);
+}
+
+- (void)layoutSubviews
+{
+    [super layoutSubviews];
+    UIEdgeInsets safe = self.safeAreaInsets;
+    const CGFloat W = self.bounds.size.width - safe.right;
+    const CGFloat H = self.bounds.size.height - safe.bottom;
+    const CGFloat top = safe.top;
+    for (XRTouchButton* b in _buttons)
+    {
+        CGPoint c{};
+        switch (b.action)
+        {
+        case actFire:      c = CGPointMake(W - 75,  H - 85);  break;
+        case actAim:       c = CGPointMake(W - 170, H - 60);  break;
+        case actJump:      c = CGPointMake(W - 60,  H - 180); break;
+        case actCrouch:    c = CGPointMake(W - 150, H - 150); break;
+        case actReload:    c = CGPointMake(W - 250, H - 50);  break;
+        case actUse:       c = CGPointMake(W - 60,  H - 260); break;
+        case actInventory: c = CGPointMake(W - 100, top + 34); break;
+        case actMenu:      c = CGPointMake(W - 36,  top + 30); break;
+        default: break;
+        }
+        b.center = c;
+    }
+}
+
+- (void)setGameplay:(BOOL)gameplay
+{
+    if (gameplay == _gameplay)
+        return;
+    _gameplay = gameplay;
+    for (XRTouchButton* b in _buttons)
+        b.hidden = !(gameplay || b.alwaysVisible);
+    if (!gameplay)
+        [self releaseStick];
+    _lookTouch = nil;
+}
+
+// В меню касания мимо кнопки «Меню» уходят в SDL (под нами)
+- (UIView*)hitTest:(CGPoint)point withEvent:(UIEvent*)event
+{
+    UIView* hit = [super hitTest:point withEvent:event];
+    if (_gameplay)
+        return hit;
+    return (hit && hit != self && !hit.hidden) ? hit : nil;
+}
+
+- (void)setDir:(int)i pressed:(bool)pressed
+{
+    if (_dir[i] == pressed)
+        return;
+    _dir[i] = pressed;
+    xr_ios_action(actFwd + i, pressed ? 1 : 0);
+}
+
+- (void)releaseStick
+{
+    for (int i = 0; i < 4; ++i)
+        [self setDir:i pressed:false];
+    _stickTouch = nil;
+    _stickBase.hidden = _stickKnob.hidden = YES;
+}
+
+- (void)touchesBegan:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event
+{
+    for (UITouch* t in touches)
+    {
+        const CGPoint p = [t locationInView:self];
+        if (!_stickTouch && p.x < self.bounds.size.width * kStickZone)
+        {
+            _stickTouch = t;
+            _stickOrigin = p;
+            _stickBase.center = _stickKnob.center = p;
+            _stickBase.hidden = _stickKnob.hidden = NO;
+        }
+        else if (!_lookTouch)
+        {
+            _lookTouch = t;
+            _lookLast = p;
+            _lookRemX = _lookRemY = 0;
+        }
+    }
+}
+
+- (void)touchesMoved:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event
+{
+    for (UITouch* t in touches)
+    {
+        const CGPoint p = [t locationInView:self];
+        if (t == _stickTouch)
+        {
+            CGFloat dx = p.x - _stickOrigin.x, dy = p.y - _stickOrigin.y;
+            const CGFloat len = sqrt(dx * dx + dy * dy), maxLen = 50;
+            CGPoint knob = p;
+            if (len > maxLen)
+                knob = CGPointMake(_stickOrigin.x + dx / len * maxLen, _stickOrigin.y + dy / len * maxLen);
+            _stickKnob.center = knob;
+            // 8 направлений: ось нажата, если её доля в векторе заметная
+            const bool active = len > kStickDeadZone;
+            [self setDir:0 pressed:active && dy < -0.38 * len];
+            [self setDir:1 pressed:active && dy > 0.38 * len];
+            [self setDir:2 pressed:active && dx < -0.38 * len];
+            [self setDir:3 pressed:active && dx > 0.38 * len];
+        }
+        else if (t == _lookTouch)
+        {
+            _lookRemX += (p.x - _lookLast.x) * kLookScale;
+            _lookRemY += (p.y - _lookLast.y) * kLookScale;
+            _lookLast = p;
+            const int ix = int(_lookRemX), iy = int(_lookRemY);
+            _lookRemX -= ix;
+            _lookRemY -= iy;
+            xr_ios_look(ix, iy);
+        }
+    }
+}
+
+- (void)touchesEnded:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event
+{
+    for (UITouch* t in touches)
+    {
+        if (t == _stickTouch)
+            [self releaseStick];
+        else if (t == _lookTouch)
+            _lookTouch = nil;
+    }
+}
+
+- (void)touchesCancelled:(NSSet<UITouch*>*)touches withEvent:(UIEvent*)event
+{
+    [self touchesEnded:touches withEvent:event];
+}
+@end
+
+static XRTouchOverlay* g_overlay;
+static UILabel* g_fps;
+
+extern "C" unsigned xr_ios_frame_counter();
+
+// Окно SDL: видимое окно, чей контроллер — SDL_uikitviewcontroller
+// (у SDL есть ещё временное окно заставки запуска — в него встраиваться нельзя).
+static UIView* FindSDLHostView()
+{
+    UIView* fallback = nil;
+    for (UIWindow* w in UIApplication.sharedApplication.windows)
+    {
+        UIViewController* vc = w.rootViewController;
+        if (w.hidden || !vc || !vc.view)
+            continue;
+        if ([NSStringFromClass(vc.class) hasPrefix:@"SDL_uikitviewcontroller"])
+            return vc.view;
+        if (w.isKeyWindow)
+            fallback = vc.view;
+    }
+    return fallback;
+}
+
+// Вызывается движком каждый кадр (CInput::OnFrame), работа — не чаще 4 раз в секунду.
+extern "C" void xr_ios_touch_tick()
+{
+    static CFTimeInterval lastTick = 0;
+    static unsigned lastFrame = 0;
+    static CFTimeInterval lastTime = CACurrentMediaTime();
+    const CFTimeInterval tickNow = CACurrentMediaTime();
+    if (tickNow - lastTick < 0.25)
+        return;
+    lastTick = tickNow;
+    @autoreleasepool {
+        UIView* host = FindSDLHostView();
+        if (!host)
+            return;
+        if (!g_overlay)
+        {
+            g_overlay = [[XRTouchOverlay alloc] initWithFrame:host.bounds];
+            g_fps = [[UILabel alloc] initWithFrame:CGRectMake(0, 0, 90, 18)];
+            g_fps.font = [UIFont monospacedDigitSystemFontOfSize:12 weight:UIFontWeightSemibold];
+            g_fps.textColor = [UIColor colorWithRed:0.6 green:1.0 blue:0.6 alpha:0.9];
+            g_fps.backgroundColor = [UIColor colorWithWhite:0 alpha:0.35];
+            g_fps.textAlignment = NSTextAlignmentCenter;
+            g_fps.userInteractionEnabled = NO;
+            [g_overlay addSubview:g_fps];
+        }
+        if (g_overlay.superview != host)
+        {
+            [g_overlay removeFromSuperview];
+            g_overlay.frame = host.bounds;
+            [host addSubview:g_overlay];
+            printf("[iOSRay] экранное управление: %s, %.0fx%.0f\n",
+                NSStringFromClass(host.class).UTF8String, host.bounds.size.width, host.bounds.size.height);
+            fflush(stdout);
+        }
+        [host bringSubviewToFront:g_overlay];
+        g_overlay.gameplay = xr_ios_input_grabbed() != 0;
+
+        // Счётчик кадров: кадры движка за реальное время
+        const unsigned frame = xr_ios_frame_counter();
+        const CFTimeInterval now = CACurrentMediaTime();
+        if (now - lastTime >= 0.5)
+        {
+            const double fps = (frame - lastFrame) / (now - lastTime);
+            g_fps.text = [NSString stringWithFormat:@"%.0f FPS", fps];
+            lastFrame = frame;
+            lastTime = now;
+        }
+        g_fps.center = CGPointMake(g_overlay.safeAreaInsets.left + 55, g_overlay.bounds.size.height - 12);
+    }
+}
+
+extern "C" void xr_ios_touch_start()
+{
+    printf("[iOSRay] экранное управление: ожидаю окно SDL\n");
+}
