+MTLBlendFactor BlendFactorOf(GLenum f)
+{
+    switch (f)
+    {
+    case GL_ZERO: return MTLBlendFactorZero;
+    case GL_ONE: return MTLBlendFactorOne;
+    case GL_SRC_COLOR: return MTLBlendFactorSourceColor;
+    case GL_ONE_MINUS_SRC_COLOR: return MTLBlendFactorOneMinusSourceColor;
+    case GL_DST_COLOR: return MTLBlendFactorDestinationColor;
+    case GL_ONE_MINUS_DST_COLOR: return MTLBlendFactorOneMinusDestinationColor;
+    case GL_SRC_ALPHA: return MTLBlendFactorSourceAlpha;
+    case GL_ONE_MINUS_SRC_ALPHA: return MTLBlendFactorOneMinusSourceAlpha;
+    case GL_DST_ALPHA: return MTLBlendFactorDestinationAlpha;
+    case GL_ONE_MINUS_DST_ALPHA: return MTLBlendFactorOneMinusDestinationAlpha;
+    case GL_CONSTANT_COLOR: return MTLBlendFactorBlendColor;
+    case GL_ONE_MINUS_CONSTANT_COLOR: return MTLBlendFactorOneMinusBlendColor;
+    case GL_CONSTANT_ALPHA: return MTLBlendFactorBlendAlpha;
+    case GL_ONE_MINUS_CONSTANT_ALPHA: return MTLBlendFactorOneMinusBlendAlpha;
+    case GL_SRC_ALPHA_SATURATE: return MTLBlendFactorSourceAlphaSaturated;
+    default: return MTLBlendFactorOne;
+    }
+}
+
+MTLBlendOperation BlendOpOf(GLenum e)
+{
+    switch (e)
+    {
+    case GL_FUNC_SUBTRACT: return MTLBlendOperationSubtract;
+    case GL_FUNC_REVERSE_SUBTRACT: return MTLBlendOperationReverseSubtract;
+    case GL_MIN: return MTLBlendOperationMin;
+    case GL_MAX: return MTLBlendOperationMax;
+    default: return MTLBlendOperationAdd;
+    }
+}
+
+MTLStencilOperation StencilOpOf(GLenum op)
+{
+    switch (op)
+    {
+    case GL_ZERO: return MTLStencilOperationZero;
+    case GL_REPLACE: return MTLStencilOperationReplace;
+    case GL_INCR: return MTLStencilOperationIncrementClamp;
+    case GL_DECR: return MTLStencilOperationDecrementClamp;
+    case GL_INVERT: return MTLStencilOperationInvert;
+    case GL_INCR_WRAP: return MTLStencilOperationIncrementWrap;
+    case GL_DECR_WRAP: return MTLStencilOperationDecrementWrap;
+    default: return MTLStencilOperationKeep;
+    }
+}
+
+// --- шейдеры → MTLFunction -------------------------------------------------------------
+const State::Lib* LibraryOf(GLuint program, const Program& p)
+{
+    State::Lib& lib = s.libraries[program];
+    if (lib.generation == p.generation && (lib.fn[0] || lib.failed))
+        return &lib;
+    lib = State::Lib{};
+    lib.generation = p.generation;
+    MTLCompileOptions* opts = [MTLCompileOptions new];
+    opts.languageVersion = MTLLanguageVersion2_1;
+    opts.fastMathEnabled = YES;
+    for (int st = 0; st < 2; ++st)
+    {
+        if (p.msl[st].empty())
+            continue;
+        NSError* err = nil;
+        NSString* src = [NSString stringWithUTF8String:p.msl[st].c_str()];
+        id<MTLLibrary> l = [core.device newLibraryWithSource:src options:opts error:&err];
+        if (!l)
+        {
+            lib.failed = true;
+            LogOnce("lib" + std::to_string(program), "! [iOSRay] Metal: MSL программы %u (%s) не собран:\n%s\n",
+                program, st ? "PS" : "VS", err.localizedDescription.UTF8String);
+            return &lib;
+        }
+        lib.fn[st] = [l newFunctionWithName:@"main0"];
+    }
+    if (!lib.fn[0])
+        lib.failed = true;
+    return &lib;
+}
+
+// --- рисование ---------------------------------------------------------------------
+struct VertexSetup
+{
+    MTLVertexDescriptor* desc = nil;
+    std::string key;
+    struct Bind
+    {
+        id<MTLBuffer> buffer;
+        NSUInteger offset;
+        NSUInteger index;
+    };
+    std::vector<Bind> binds;
+    bool needDummy = false;
+};
+
+bool BuildVertexSetup(const Program& p, VertexSetup& vs)
+{
+    vs.desc = [MTLVertexDescriptor vertexDescriptor];
+    const Vao& vao = s.vaos[s.vao];
+    struct Group
+    {
+        GLuint buffer;
+        GLsizei stride;
+        uintptr_t base;
+    };
+    std::vector<Group> groups;
+    char buf[96];
+    for (const VertexInput& in : p.vsInputs)
+    {
+        if (in.location >= kMaxAttribs)
+            continue;
+        const Attrib& a = vao.attribs[in.location];
+        id<MTLBuffer> mb = a.enabled ? BufferObject(a.buffer) : nil;
+        MTLVertexAttributeDescriptor* ad = vs.desc.attributes[in.location];
+        if (!mb)
+        {
+            ad.format = in.isInt ? MTLVertexFormatInt4 : MTLVertexFormatFloat4;
+            ad.offset = 0;
+            ad.bufferIndex = kDummyVertexBufferIndex;
+            vs.needDummy = true;
+            snprintf(buf, sizeof(buf), "a%u:d|", in.location);
+            vs.key += buf;
+            continue;
+        }
+        const GLsizei stride = a.stride ? a.stride : GLsizei(VertexFormatSize(a));
+        size_t g = 0;
+        for (; g < groups.size(); ++g)
+            if (groups[g].buffer == a.buffer && groups[g].stride == stride)
+                break;
+        if (g == groups.size())
+            groups.push_back({ a.buffer, stride, a.offset });
+        else
+            groups[g].base = std::min(groups[g].base, a.offset);
+    }
+    // второй проход: смещения относительно базы группы
+    for (const VertexInput& in : p.vsInputs)
+    {
+        if (in.location >= kMaxAttribs)
+            continue;
+        const Attrib& a = vao.attribs[in.location];
+        if (!a.enabled || !BufferObject(a.buffer))
+            continue;
+        const GLsizei stride = a.stride ? a.stride : GLsizei(VertexFormatSize(a));
+        for (size_t g = 0; g < groups.size(); ++g)
+            if (groups[g].buffer == a.buffer && groups[g].stride == stride)
+            {
+                MTLVertexAttributeDescriptor* ad = vs.desc.attributes[in.location];
+                ad.format = VertexFormatOf(a);
+                ad.offset = NSUInteger(a.offset - groups[g].base);
+                ad.bufferIndex = kFirstVertexBufferIndex + g;
+                snprintf(buf, sizeof(buf), "a%u:%d:%lu:%lu|", in.location, int(ad.format), (unsigned long)ad.offset,
+                    (unsigned long)g);
+                vs.key += buf;
+                break;
+            }
+    }
+    for (size_t g = 0; g < groups.size(); ++g)
+    {
+        if (kFirstVertexBufferIndex + g >= kDummyVertexBufferIndex)
+            return false;
+        MTLVertexBufferLayoutDescriptor* ld = vs.desc.layouts[kFirstVertexBufferIndex + g];
+        ld.stride = NSUInteger(groups[g].stride);
+        ld.stepFunction = MTLVertexStepFunctionPerVertex;
+        vs.binds.push_back({ BufferObject(groups[g].buffer), NSUInteger(groups[g].base), kFirstVertexBufferIndex + g });
+        snprintf(buf, sizeof(buf), "L%lu:%d|", (unsigned long)g, int(groups[g].stride));
+        vs.key += buf;
+    }
+    if (vs.needDummy)
+    {
+        MTLVertexBufferLayoutDescriptor* ld = vs.desc.layouts[kDummyVertexBufferIndex];
+        ld.stride = 16;
+        ld.stepFunction = MTLVertexStepFunctionConstant;
+        ld.stepRate = 0;
+    }
+    return true;
+}
+
+id<MTLRenderPipelineState> PipelineOf(GLuint program, const Program& p, const State::Lib& lib, const VertexSetup& vs,
+    const PassTargets& t)
+{
+    std::string key;
+    key.reserve(256);
+    char buf[160];
+    snprintf(buf, sizeof(buf), "%u:%u|", program, p.generation);
+    key += buf;
+    key += vs.key;
+    for (int i = 0; i < kMaxColor; ++i)
+    {
+        snprintf(buf, sizeof(buf), "c%d|", t.color[i] ? int(t.color[i].pixelFormat) : 0);
+        key += buf;
+    }
+    snprintf(buf, sizeof(buf), "d%d s%d b%d %x %x %x %x %x %x m%d%d%d%d", t.depth ? int(t.depth.pixelFormat) : 0,
+        t.stencil ? int(t.stencil.pixelFormat) : 0, int(s.blend), s.blendSrcRGB, s.blendDstRGB, s.blendSrcA,
+        s.blendDstA, s.blendEqRGB, s.blendEqA, s.colorMask[0], s.colorMask[1], s.colorMask[2], s.colorMask[3]);
+    key += buf;
+    const auto it = s.pipelines.find(key);
+    if (it != s.pipelines.end())
+        return it->second;
+
+    MTLRenderPipelineDescriptor* d = [MTLRenderPipelineDescriptor new];
+    d.vertexFunction = lib.fn[0];
+    d.fragmentFunction = lib.fn[1];
+    d.vertexDescriptor = vs.desc;
+    MTLColorWriteMask mask = MTLColorWriteMaskNone;
+    if (s.colorMask[0]) mask |= MTLColorWriteMaskRed;
+    if (s.colorMask[1]) mask |= MTLColorWriteMaskGreen;
+    if (s.colorMask[2]) mask |= MTLColorWriteMaskBlue;
+    if (s.colorMask[3]) mask |= MTLColorWriteMaskAlpha;
+    for (int i = 0; i < kMaxColor; ++i)
+    {
+        if (!t.color[i])
+            continue;
+        MTLRenderPipelineColorAttachmentDescriptor* c = d.colorAttachments[i];
+        c.pixelFormat = t.color[i].pixelFormat;
+        c.writeMask = mask;
+        c.blendingEnabled = s.blend && IsBlendable(c.pixelFormat);
+        c.sourceRGBBlendFactor = BlendFactorOf(s.blendSrcRGB);
+        c.destinationRGBBlendFactor = BlendFactorOf(s.blendDstRGB);
+        c.sourceAlphaBlendFactor = BlendFactorOf(s.blendSrcA);
+        c.destinationAlphaBlendFactor = BlendFactorOf(s.blendDstA);
+        c.rgbBlendOperation = BlendOpOf(s.blendEqRGB);
+        c.alphaBlendOperation = BlendOpOf(s.blendEqA);
+    }
+    if (t.depth)
+        d.depthAttachmentPixelFormat = t.depth.pixelFormat;
+    if (t.stencil)
+        d.stencilAttachmentPixelFormat = t.stencil.pixelFormat;
+    NSError* err = nil;
+    id<MTLRenderPipelineState> pso = [core.device newRenderPipelineStateWithDescriptor:d error:&err];
+    if (!pso)
+        LogOnce("pso" + std::to_string(program), "! [iOSRay] Metal: PSO программы %u не создан: %s\n", program,
+            err.localizedDescription.UTF8String);
+    s.pipelines[key] = pso;
+    return pso;
+}
+
+id<MTLDepthStencilState> DepthStateOf(const PassTargets& t)
+{
+    const bool depth = t.depth && s.depthTest;
+    const bool stencil = t.stencil && s.stencilTest;
+    char buf[160];
+    snprintf(buf, sizeof(buf), "%d%d%x%d|%x%x%x%x%x%x|%x%x%x%x%x%x", depth, stencil, s.depthFunc, s.depthMask,
+        s.stFront.func, s.stFront.readMask, s.stFront.writeMask, s.stFront.sfail, s.stFront.dpfail, s.stFront.dppass,
+        s.stBack.func, s.stBack.readMask, s.stBack.writeMask, s.stBack.sfail, s.stBack.dpfail, s.stBack.dppass);
+    const std::string key = buf;
+    const auto it = s.depthStates.find(key);
+    if (it != s.depthStates.end())
+        return it->second;
+    MTLDepthStencilDescriptor* d = [MTLDepthStencilDescriptor new];
+    d.depthCompareFunction = depth ? CompareOf(s.depthFunc) : MTLCompareFunctionAlways;
+    d.depthWriteEnabled = depth && s.depthMask;
+    if (stencil)
+    {
+        for (int f = 0; f < 2; ++f)
+        {
+            const StencilFace& sf = f ? s.stBack : s.stFront;
+            MTLStencilDescriptor* sd = [MTLStencilDescriptor new];
+            sd.stencilCompareFunction = CompareOf(sf.func);
+            sd.stencilFailureOperation = StencilOpOf(sf.sfail);
+            sd.depthFailureOperation = StencilOpOf(sf.dpfail);
+            sd.depthStencilPassOperation = StencilOpOf(sf.dppass);
+            sd.readMask = sf.readMask & 0xFF;
+            sd.writeMask = sf.writeMask & 0xFF;
+            if (f)
+                d.backFaceStencil = sd;
+            else
+                d.frontFaceStencil = sd;
+        }
+    }
+    id<MTLDepthStencilState> ds = [core.device newDepthStencilStateWithDescriptor:d];
+    s.depthStates[key] = ds;
+    return ds;
+}
+
+id<MTLTexture> DummyFor(GLenum samplerType)
+{
+    switch (samplerType)
+    {
+    case GL_SAMPLER_3D: return s.dummy3D;
+    case GL_SAMPLER_CUBE: return s.dummyCube;
+    case GL_SAMPLER_2D_SHADOW: return s.dummyDepth;
+    case GL_SAMPLER_2D_ARRAY: return s.dummyArray;
+    default: return s.dummy2D;
+    }
+}
+
+bool PrepareDraw(MTLPrimitiveType& prim, GLenum mode)
+{
+    switch (mode)
+    {
+    case GL_TRIANGLES: prim = MTLPrimitiveTypeTriangle; break;
+    case GL_TRIANGLE_STRIP: prim = MTLPrimitiveTypeTriangleStrip; break;
+    case GL_LINES: prim = MTLPrimitiveTypeLine; break;
+    case GL_LINE_STRIP: prim = MTLPrimitiveTypeLineStrip; break;
+    case GL_POINTS: prim = MTLPrimitiveTypePoint; break;
+    default:
+        LogOnce("prim" + std::to_string(mode), "! [iOSRay] Metal: примитив 0x%x не поддержан\n", mode);
+        return false;
+    }
+
+    const GLuint program = CurrentProgram();
+    const Program* p = FindProgram(program);
+    if (!p || !p->linked)
+        return false;
+    const State::Lib* lib = LibraryOf(program, *p);
+    if (!lib || lib->failed)
+        return false;
+
+    const PassTargets t = CurrentTargets();
+    if (t.empty)
+        return false;
+
+    VertexSetup vs;
+    if (!BuildVertexSetup(*p, vs))
+        return false;
+    id<MTLRenderPipelineState> pso = PipelineOf(program, *p, *lib, vs, t);
+    if (!pso)
+        return false;
+
+    if (!s.enc || s.encKey != t.key)
+        BeginPass(t, 0);
+    id<MTLRenderCommandEncoder> e = s.enc;
+    [e setRenderPipelineState:pso];
+    [e setDepthStencilState:DepthStateOf(t)];
+    [e setStencilFrontReferenceValue:uint32_t(s.stFront.ref) & 0xFF backReferenceValue:uint32_t(s.stBack.ref) & 0xFF];
+    [e setCullMode:s.cull ? (s.cullFace == GL_FRONT ? MTLCullModeFront : s.cullFace == GL_BACK ? MTLCullModeBack
+                                                                                              : MTLCullModeNone)
+                          : MTLCullModeNone];
+    // Y перевёрнут в шейдере → обход граней в Metal противоположный GL
+    [e setFrontFacingWinding:s.frontFace == GL_CCW ? MTLWindingClockwise : MTLWindingCounterClockwise];
+    if (s.polygonOffsetFill)
+        [e setDepthBias:s.polyUnits slopeScale:s.polyFactor clamp:0];
+    else
+        [e setDepthBias:0 slopeScale:0 clamp:0];
+    [e setBlendColorRed:s.blendColor[0] green:s.blendColor[1] blue:s.blendColor[2] alpha:s.blendColor[3]];
+
+    MTLViewport vp;
+    vp.originX = s.viewport[0];
+    vp.originY = s.viewport[1];
+    vp.width = s.viewport[2];
+    vp.height = s.viewport[3];
+    vp.znear = s.depthNear;
+    vp.zfar = s.depthFar;
+    [e setViewport:vp];
+    MTLScissorRect sc = { 0, 0, NSUInteger(t.width), NSUInteger(t.height) };
+    if (s.scissorTest)
+    {
+        const int x0 = std::clamp(s.scissor[0], 0, t.width), y0 = std::clamp(s.scissor[1], 0, t.height);
+        const int x1 = std::clamp(s.scissor[0] + s.scissor[2], 0, t.width);
+        const int y1 = std::clamp(s.scissor[1] + s.scissor[3], 0, t.height);
+        sc = { NSUInteger(x0), NSUInteger(y0), NSUInteger(std::max(0, x1 - x0)), NSUInteger(std::max(0, y1 - y0)) };
+        if (sc.width == 0 || sc.height == 0)
+            return false;
+    }
+    [e setScissorRect:sc];
+
+    for (const VertexSetup::Bind& b : vs.binds)
+        [e setVertexBuffer:b.buffer offset:b.offset atIndex:b.index];
+    if (vs.needDummy)
+        [e setVertexBuffer:s.dummyVertex offset:0 atIndex:kDummyVertexBufferIndex];
+
+    // uniform-блоки стадий
+    for (int st = 0; st < 2; ++st)
+    {
+        const std::vector<uint8_t>& block = p->block[st];
+        if (block.empty())
+            continue;
+        const Alloc a = Transient(block.size());
+        memcpy(a.ptr, block.data(), block.size());
+        if (st == 0)
+            [e setVertexBuffer:a.buffer offset:a.offset atIndex:kUniformBufferIndex];
+        else
+            [e setFragmentBuffer:a.buffer offset:a.offset atIndex:kUniformBufferIndex];
+    }
+
+    // текстуры и сэмплеры
+    for (const Uniform& u : p->uniforms)
+    {
+        if (!u.isSampler)
+            continue;
+        const GLuint unit = GLuint(std::clamp<GLint>(u.samplerUnit, 0, kMaxUnits - 1));
+        const GLuint name = u.glType == GL_SAMPLER_3D ? s.unit3D[unit]
+            : u.glType == GL_SAMPLER_CUBE             ? s.unitCube[unit]
+                                                      : s.unit2D[unit];
+        const auto it = s.textures.find(name);
+        const Texture* tex = it == s.textures.end() ? nullptr : &it->second;
+        id<MTLTexture> mt = tex ? tex->mtl : nil;
+        const bool wantDepth = u.glType == GL_SAMPLER_2D_SHADOW;
+        if (mt && wantDepth != IsDepth(mt.pixelFormat))
+            mt = nil; // несовпадение типа текстуры и сэмплера в шейдере
+        if (mt && (mt.textureType == MTLTextureTypeCube) != (u.glType == GL_SAMPLER_CUBE))
+            mt = nil;
+        if (mt && (mt.textureType == MTLTextureType3D) != (u.glType == GL_SAMPLER_3D))
+            mt = nil;
+        if (!mt)
+            mt = DummyFor(u.glType);
+        SamplerParams sp = tex ? tex->params : SamplerParams{};
+        if (s.unitSampler[unit])
+            sp = s.samplers[s.unitSampler[unit]];
+        if (!wantDepth)
+            sp.compareMode = GL_NONE;
+        id<MTLSamplerState> ss = SamplerStateOf(sp, mt ? int(mt.mipmapLevelCount) : 1);
+        for (int st = 0; st < 2; ++st)
+        {
+            if (!u.slot[st].present)
+                continue;
+            const NSUInteger idx = u.slot[st].textureIndex;
+            if (st == 0)
+            {
+                [e setVertexTexture:mt atIndex:idx];
+                [e setVertexSamplerState:ss atIndex:idx];
+            }
+            else
+            {
+                [e setFragmentTexture:mt atIndex:idx];
+                [e setFragmentSamplerState:ss atIndex:idx];
+            }
+        }
+    }
+    ++s.draws;
+    return true;
+}
+
+void gl_DrawArrays(GLenum mode, GLint first, GLsizei count)
+{
+    MTLPrimitiveType prim;
+    if (count <= 0 || !PrepareDraw(prim, mode))
+    {
+        ++s.skipped;
+        return;
+    }
+    [s.enc drawPrimitives:prim vertexStart:NSUInteger(first) vertexCount:NSUInteger(count)];
+}
+
+void DrawIndexed(GLenum mode, GLsizei count, GLenum type, const void* indices, GLint baseVertex)
+{
+    MTLPrimitiveType prim;
+    id<MTLBuffer> ib = BufferObject(s.vaos[s.vao].elementBuffer);
+    if (count <= 0 || !ib || !PrepareDraw(prim, mode))
+    {
+        ++s.skipped;
+        return;
+    }
+    const MTLIndexType it = type == GL_UNSIGNED_INT ? MTLIndexTypeUInt32 : MTLIndexTypeUInt16;
+    const size_t isz = type == GL_UNSIGNED_INT ? 4 : 2;
+    NSUInteger off = NSUInteger(reinterpret_cast<uintptr_t>(indices));
+    if (off + NSUInteger(count) * isz > ib.length)
+    {
+        ++s.skipped;
+        return;
+    }
+    if (off % 4)
+    {
+        // Metal хочет смещение индексов, кратное 4: копируем во временный буфер
+        const Alloc a = Transient(size_t(count) * isz, 4);
+        memcpy(a.ptr, static_cast<const uint8_t*>(ib.contents) + off, size_t(count) * isz);
+        ib = a.buffer;
+        off = a.offset;
+    }
+    if (baseVertex)
+        [s.enc drawIndexedPrimitives:prim indexCount:NSUInteger(count) indexType:it indexBuffer:ib
+                   indexBufferOffset:off instanceCount:1 baseVertex:baseVertex baseInstance:0];
+    else
+        [s.enc drawIndexedPrimitives:prim indexCount:NSUInteger(count) indexType:it indexBuffer:ib
+                   indexBufferOffset:off];
+}
+
+void gl_DrawElements(GLenum mode, GLsizei count, GLenum type, const void* indices)
+{
+    DrawIndexed(mode, count, type, indices, 0);
+}
+void gl_DrawElementsBaseVertex(GLenum mode, GLsizei count, GLenum type, const void* indices, GLint baseVertex)
+{
+    DrawIndexed(mode, count, type, indices, baseVertex);
+}
+void gl_DrawRangeElements(GLenum mode, GLuint, GLuint, GLsizei count, GLenum type, const void* indices)
+{
+    DrawIndexed(mode, count, type, indices, 0);
+}
+
+// --- копирования ---------------------------------------------------------------------
+id<MTLTexture> ReadColor0()
+{
+    if (!s.readFbo)
+        return nil;
+    const Fbo& f = s.fbos[s.readFbo];
+    return TexOf(f.color[0]);
+}
+
+void gl_BlitFramebuffer(GLint sx0, GLint sy0, GLint sx1, GLint sy1, GLint dx0, GLint dy0, GLint dx1, GLint dy1,
+    GLbitfield mask, GLenum)
+{
+    if (!(mask & GL_COLOR_BUFFER_BIT))
+        return;
+    id<MTLTexture> src = ReadColor0();
+    if (!s.drawFbo)
+    {
+        s.presentSource = src; // вывод на экран — в RenderPresent
+        return;
+    }
+    const PassTargets t = CurrentTargets();
+    id<MTLTexture> dst = t.color[0];
+    if (!src || !dst || src.pixelFormat != dst.pixelFormat || sx1 - sx0 != dx1 - dx0 || sy1 - sy0 != dy1 - dy0)
+    {
+        LogOnce("blit", "! [iOSRay] Metal: glBlitFramebuffer с масштабом/форматом пока пропускается\n");
+        return;
+    }
+    BeginFrameIfNeeded();
+    EndEncoder();
+    id<MTLBlitCommandEncoder> b = [s.cmd blitCommandEncoder];
+    [b copyFromTexture:src sourceSlice:0 sourceLevel:0
+          sourceOrigin:MTLOriginMake(NSUInteger(sx0), NSUInteger(sy0), 0)
+            sourceSize:MTLSizeMake(NSUInteger(sx1 - sx0), NSUInteger(sy1 - sy0), 1)
+             toTexture:dst destinationSlice:0 destinationLevel:0
+     destinationOrigin:MTLOriginMake(NSUInteger(dx0), NSUInteger(dy0), 0)];
+    [b endEncoding];
+}
+
+void gl_CopyTexSubImage2D(GLenum target, GLint level, GLint dx, GLint dy, GLint x, GLint y, GLsizei w, GLsizei h)
+{
+    Texture* t = BoundTexture(target);
+    id<MTLTexture> src = ReadColor0();
+    if (!t || !t->mtl || !src || src.pixelFormat != t->mtl.pixelFormat)
+        return;
+    BeginFrameIfNeeded();
+    EndEncoder();
+    id<MTLBlitCommandEncoder> b = [s.cmd blitCommandEncoder];
+    [b copyFromTexture:src sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(NSUInteger(x), NSUInteger(y), 0)
+            sourceSize:MTLSizeMake(NSUInteger(w), NSUInteger(h), 1)
+             toTexture:t->mtl destinationSlice:SliceOf(target) destinationLevel:NSUInteger(level)
+     destinationOrigin:MTLOriginMake(NSUInteger(dx), NSUInteger(dy), 0)];
+    [b endEncoding];
+}
+
+void gl_GenerateMipmap(GLenum target)
+{
+    Texture* t = BoundTexture(target);
+    if (!t || !t->mtl || t->levels <= 1 || IsAstc(t->format) || IsDepth(t->format))
+        return;
+    BeginFrameIfNeeded();
+    EndEncoder();
+    id<MTLBlitCommandEncoder> b = [s.cmd blitCommandEncoder];
+    [b generateMipmapsForTexture:t->mtl];
+    [b endEncoding];
+}
+
+// --- вывод кадра -------------------------------------------------------------------------
+const char* const kBlitMsl = R"(
+#include <metal_stdlib>
+using namespace metal;
+struct V { float4 p [[position]]; float2 uv; };
+vertex V vs_blit(uint vid [[vertex_id]])
+{
+    const float2 pos = float2((vid << 1) & 2, vid & 2);
+    V o;
+    o.p = float4(pos * 2.0 - 1.0, 0.0, 1.0);
+    o.uv = pos; // строка 0 исходника — низ кадра (как в GL)
+    return o;
+}
+fragment float4 fs_blit(V in [[stage_in]], texture2d<float> t [[texture(0)]], sampler sm [[sampler(0)]])
+{
+    return float4(t.sample(sm, in.uv).rgb, 1.0);
+}
+)";
+
+id<MTLTexture> MakeDummy(MTLTextureType type, MTLPixelFormat fmt)
+{
+    id<MTLTexture> t = MakeTexture(type, fmt, 1, 1, 1, 1);
+    if (!IsDepth(fmt))
+    {
+        const uint32_t black = 0xFF000000u;
+        const int slices = type == MTLTextureTypeCube ? 6 : 1;
+        for (int i = 0; i < slices; ++i)
+            [t replaceRegion:MTLRegionMake3D(0, 0, 0, 1, 1, 1) mipmapLevel:0 slice:NSUInteger(i) withBytes:&black
+                 bytesPerRow:4 bytesPerImage:type == MTLTextureType3D ? 4 : 0];
+    }
+    return t;
+}
+} // namespace
+
+// --- внешний интерфейс -------------------------------------------------------------
+GLuint ElementBufferBinding() { return s.vaos[s.vao].elementBuffer; }
+void SetElementBufferBinding(GLuint buffer) { s.vaos[s.vao].elementBuffer = buffer; }
+void SetArrayBufferBinding(GLuint buffer) { g_arrayBuffer = buffer; }
+
+void RenderInit()
+{
+    s.inFlight = dispatch_semaphore_create(kFramesInFlight);
+    s.dummy2D = MakeDummy(MTLTextureType2D, MTLPixelFormatRGBA8Unorm);
+    s.dummy3D = MakeDummy(MTLTextureType3D, MTLPixelFormatRGBA8Unorm);
+    s.dummyCube = MakeDummy(MTLTextureTypeCube, MTLPixelFormatRGBA8Unorm);
+    s.dummyArray = MakeDummy(MTLTextureType2DArray, MTLPixelFormatRGBA8Unorm);
+    s.dummyDepth = MakeDummy(MTLTextureType2D, MTLPixelFormatDepth32Float);
+    s.dummyVertex = [core.device newBufferWithLength:64 options:MTLResourceStorageModeShared];
+    memset(s.dummyVertex.contents, 0, 64);
+
+    NSError* err = nil;
+    id<MTLLibrary> lib = [core.device newLibraryWithSource:@(kBlitMsl) options:nil error:&err];
+    if (lib)
+    {
+        MTLRenderPipelineDescriptor* d = [MTLRenderPipelineDescriptor new];
+        d.vertexFunction = [lib newFunctionWithName:@"vs_blit"];
+        d.fragmentFunction = [lib newFunctionWithName:@"fs_blit"];
+        d.colorAttachments[0].pixelFormat = core.layer.pixelFormat;
+        s.blitPipeline = [core.device newRenderPipelineStateWithDescriptor:d error:&err];
+    }
+    if (!s.blitPipeline)
+        printf("! [iOSRay] Metal: шейдер вывода на экран не собран: %s\n", err.localizedDescription.UTF8String);
+    MTLSamplerDescriptor* sd = [MTLSamplerDescriptor new];
+    sd.minFilter = sd.magFilter = MTLSamplerMinMagFilterLinear;
+    s.blitSampler = [core.device newSamplerStateWithDescriptor:sd];
+    fflush(stdout);
+}
+
+void RenderPresent()
+{
+    BeginFrameIfNeeded();
+    EndEncoder();
+    @autoreleasepool
+    {
+        id<CAMetalDrawable> drawable = [core.layer nextDrawable];
+        if (drawable)
+        {
+            MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+            rp.colorAttachments[0].texture = drawable.texture;
+            rp.colorAttachments[0].loadAction = MTLLoadActionClear;
+            rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+            rp.colorAttachments[0].clearColor = MTLClearColorMake(0.12, 0.12, 0.13, 1.0);
+            id<MTLRenderCommandEncoder> e = [s.cmd renderCommandEncoderWithDescriptor:rp];
+            if (s.presentSource && s.blitPipeline)
+            {
+                [e setRenderPipelineState:s.blitPipeline];
+                [e setFragmentTexture:s.presentSource atIndex:0];
+                [e setFragmentSamplerState:s.blitSampler atIndex:0];
+                [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+            }
+            [e endEncoding];
+            [s.cmd presentDrawable:drawable];
+        }
+        dispatch_semaphore_t sem = s.inFlight;
+        [s.cmd addCompletedHandler:^(id<MTLCommandBuffer> cb) {
+            if (cb.error)
+                printf("! [iOSRay] Metal: ошибка GPU: %s\n", cb.error.localizedDescription.UTF8String);
+            dispatch_semaphore_signal(sem);
+        }];
+        [s.cmd commit];
+        s.cmd = nil;
+    }
+    ++s.frameIndex;
+    if ((s.frameIndex % 600) == 1)
+    {
+        printf("[iOSRay] Metal: кадр %u — рисований %u (пропущено %u), проходов %u, PSO %zu, источник %s\n",
+            s.frameIndex, s.draws, s.skipped, s.passes, s.pipelines.size(),
+            s.presentSource ? [NSString stringWithFormat:@"%lux%lu", (unsigned long)s.presentSource.width,
+                                                          (unsigned long)s.presentSource.height].UTF8String
+                            : "нет");
+        fflush(stdout);
+    }
+    s.draws = s.skipped = s.passes = 0;
+    s.presentSource = nil;
+}
+
