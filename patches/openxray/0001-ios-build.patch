+void SetCap(GLenum cap, bool on)
+{
+    switch (cap)
+    {
+    case GL_BLEND: s.blend = on; break;
+    case GL_DEPTH_TEST: s.depthTest = on; break;
+    case GL_STENCIL_TEST: s.stencilTest = on; break;
+    case GL_CULL_FACE: s.cull = on; break;
+    case GL_SCISSOR_TEST: s.scissorTest = on; break;
+    case GL_POLYGON_OFFSET_FILL: s.polygonOffsetFill = on; break;
+    default: break;
+    }
+}
+void gl_Enable(GLenum cap) { SetCap(cap, true); }
+void gl_Disable(GLenum cap) { SetCap(cap, false); }
+GLboolean gl_IsEnabled(GLenum cap)
+{
+    switch (cap)
+    {
+    case GL_BLEND: return s.blend;
+    case GL_DEPTH_TEST: return s.depthTest;
+    case GL_STENCIL_TEST: return s.stencilTest;
+    case GL_CULL_FACE: return s.cull;
+    case GL_SCISSOR_TEST: return s.scissorTest;
+    default: return GL_FALSE;
+    }
+}
+void gl_BlendFunc(GLenum src, GLenum dst)
+{
+    s.blendSrcRGB = s.blendSrcA = src;
+    s.blendDstRGB = s.blendDstA = dst;
+}
+void gl_BlendFuncSeparate(GLenum sr, GLenum dr, GLenum sa, GLenum da)
+{
+    s.blendSrcRGB = sr; s.blendDstRGB = dr; s.blendSrcA = sa; s.blendDstA = da;
+}
+void gl_BlendEquation(GLenum e) { s.blendEqRGB = s.blendEqA = e; }
+void gl_BlendEquationSeparate(GLenum rgb, GLenum a) { s.blendEqRGB = rgb; s.blendEqA = a; }
+void gl_BlendColor(GLfloat r, GLfloat g, GLfloat b, GLfloat a)
+{
+    s.blendColor[0] = r; s.blendColor[1] = g; s.blendColor[2] = b; s.blendColor[3] = a;
+}
+void gl_ColorMask(GLboolean r, GLboolean g, GLboolean b, GLboolean a)
+{
+    s.colorMask[0] = r; s.colorMask[1] = g; s.colorMask[2] = b; s.colorMask[3] = a;
+}
+void gl_DepthFunc(GLenum f) { s.depthFunc = f; }
+void gl_DepthMask(GLboolean m) { s.depthMask = m == GL_TRUE; }
+void gl_DepthRangef(GLfloat n, GLfloat f) { s.depthNear = n; s.depthFar = f; }
+void gl_StencilFuncSeparate(GLenum face, GLenum func, GLint ref, GLuint mask)
+{
+    for (StencilFace* f : { &s.stFront, &s.stBack })
+        if ((face == GL_FRONT_AND_BACK) || (face == GL_FRONT && f == &s.stFront) || (face == GL_BACK && f == &s.stBack))
+        {
+            f->func = func;
+            f->ref = ref;
+            f->readMask = mask;
+        }
+}
+void gl_StencilFunc(GLenum func, GLint ref, GLuint mask) { gl_StencilFuncSeparate(GL_FRONT_AND_BACK, func, ref, mask); }
+void gl_StencilMaskSeparate(GLenum face, GLuint mask)
+{
+    if (face != GL_BACK)
+        s.stFront.writeMask = mask;
+    if (face != GL_FRONT)
+        s.stBack.writeMask = mask;
+}
+void gl_StencilMask(GLuint mask) { gl_StencilMaskSeparate(GL_FRONT_AND_BACK, mask); }
+void gl_StencilOpSeparate(GLenum face, GLenum sf, GLenum df, GLenum dp)
+{
+    for (StencilFace* f : { &s.stFront, &s.stBack })
+        if ((face == GL_FRONT_AND_BACK) || (face == GL_FRONT && f == &s.stFront) || (face == GL_BACK && f == &s.stBack))
+        {
+            f->sfail = sf;
+            f->dpfail = df;
+            f->dppass = dp;
+        }
+}
+void gl_StencilOp(GLenum sf, GLenum df, GLenum dp) { gl_StencilOpSeparate(GL_FRONT_AND_BACK, sf, df, dp); }
+void gl_CullFace(GLenum m) { s.cullFace = m; }
+void gl_FrontFace(GLenum m) { s.frontFace = m; }
