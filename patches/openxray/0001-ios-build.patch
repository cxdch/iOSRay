 namespace xray::render::RENDER_NAMESPACE
 {
+#if defined(USE_OGL) && defined(XR_GL_ES) && defined(__APPLE__)
+// iOSRay: в Metal-режиме GL-контекста нет, а бэкенд ImGui ходит в системный
+// OpenGL ES напрямую (мимо glad) — glGetString вернёт NULL и всё упадёт.
+// Отладочный ImGui там просто выключаем.
+static bool ImGuiOff() { return strstr(Core.Params, "-xr_metal") != nullptr; }
+// ImGui 1.92 сам строит атлас шрифтов и просит бэкенд создать текстуру.
+// Отвечаем «готово» с фиктивным id — рисовать всё равно нечем.
+static void ImGuiFakeTextures()
+{
+    for (ImTextureData* tex : ImGui::GetPlatformIO().Textures)
+    {
+        if (tex->Status == ImTextureStatus_WantCreate || tex->Status == ImTextureStatus_WantUpdates)
+        {
+            if (tex->TexID == ImTextureID_Invalid)
+                tex->SetTexID((ImTextureID)1);
+            tex->SetStatus(ImTextureStatus_OK);
+        }
+        else if (tex->Status == ImTextureStatus_WantDestroy)
+        {
+            tex->SetTexID(ImTextureID_Invalid);
+            tex->SetStatus(ImTextureStatus_Destroyed);
+        }
+    }
+}
+#define XR_IMGUI_GUARD() if (ImGuiOff()) { ImGuiFakeTextures(); return; }
+#else
+#define XR_IMGUI_GUARD() (void)0
+#endif
