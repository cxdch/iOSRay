+// ---------------------------------------------------------------------------
+// iOSRay: C-интерфейс для экранного управления (src/xr_3da/ios_touch.mm).
+// Кнопки не знают клавиш: они просят действие, а мы находим, на что оно
+// назначено в default_controls.ltx/user.ltx, и шлём в SDL нужное событие.
+// ---------------------------------------------------------------------------
+extern "C" unsigned xr_ios_frame_counter()
+{
+    return Device.dwFrame;
+}
+
+extern "C" int xr_ios_input_grabbed()
+{
+    return pInput && pInput->InputIsGrabbed() ? 1 : 0;
+}
+
+static int xr_ios_bound_dik(EGameActions action)
+{
+    for (int i = 0; i < bindtypes_count; ++i)
+    {
+        const int dik = GetActionDik(action, i);
+        if (dik == SDL_SCANCODE_UNKNOWN)
+            continue;
+        if (dik < SDL_NUM_SCANCODES || (dik > MOUSE_INVALID && dik < MOUSE_MAX))
+            return dik;
+    }
+    return SDL_SCANCODE_UNKNOWN;
+}
+
+extern "C" void xr_ios_action(int iosAction, int down)
+{
+    static const EGameActions map[] = {
+        kFWD, kBACK, kL_STRAFE, kR_STRAFE,           // 0..3  движение
+        kWPN_FIRE, kWPN_ZOOM, kJUMP, kCROUCH,        // 4..7
+        kUSE, kWPN_RELOAD, kINVENTORY, kQUIT,        // 8..11
+    };
+    if (iosAction < 0 || iosAction >= int(std::size(map)))
+        return;
+
+    int dik = xr_ios_bound_dik(map[iosAction]);
+    if (map[iosAction] == kQUIT && dik == SDL_SCANCODE_UNKNOWN)
+        dik = SDL_SCANCODE_ESCAPE;
+    if (dik == SDL_SCANCODE_UNKNOWN)
+        return;
+
+    SDL_Event e{};
+    const Uint32 wnd = Device.m_sdlWnd ? SDL_GetWindowID(Device.m_sdlWnd) : 0;
+    if (dik < SDL_NUM_SCANCODES)
+    {
+        e.type = down ? SDL_KEYDOWN : SDL_KEYUP;
+        e.key.windowID = wnd;
+        e.key.state = down ? SDL_PRESSED : SDL_RELEASED;
+        e.key.keysym.scancode = SDL_Scancode(dik);
+        e.key.keysym.sym = SDL_GetKeyFromScancode(SDL_Scancode(dik));
+    }
+    else
+    {
+        // X-Ray: MOUSE_1 левая, MOUSE_2 правая, MOUSE_3 средняя (см. RemapIdx в MouseUpdate)
+        static const Uint8 toSdl[] = { SDL_BUTTON_LEFT, SDL_BUTTON_RIGHT, SDL_BUTTON_MIDDLE, SDL_BUTTON_X1, SDL_BUTTON_X2 };
+        e.type = down ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+        e.button.windowID = wnd;
+        e.button.which = 0;
+        e.button.button = toSdl[dik - MOUSE_1];
+        e.button.state = down ? SDL_PRESSED : SDL_RELEASED;
+        e.button.clicks = 1;
+    }
+    SDL_PushEvent(&e);
+}
+
+extern "C" void xr_ios_look(int dx, int dy)
+{
+    if (!dx && !dy)
+        return;
+    SDL_Event e{};
+    e.type = SDL_MOUSEMOTION;
+    e.motion.windowID = Device.m_sdlWnd ? SDL_GetWindowID(Device.m_sdlWnd) : 0;
+    e.motion.which = 0;
+    e.motion.xrel = dx;
+    e.motion.yrel = dy;
+    SDL_PushEvent(&e);
+}
+#endif
+#endif
