diff --git a/src/Layers/xrRenderGL/mtl/glmtl.mm b/src/Layers/xrRenderGL/mtl/glmtl.mm
new file mode 100644
index 00000000..11147d8e
--- /dev/null
+++ b/src/Layers/xrRenderGL/mtl/glmtl.mm
@@ -0,0 +1,453 @@
+// iOSRay: Metal-режим рендера.
+//
+// Рендер OpenXRay продолжает вызывать функции OpenGL ES (через указатели glad),
+// но в Metal-режиме glad загружается не из драйвера Apple, а отсюда.
+// Здесь: общие запросы (glGet*), имена объектов, буферы (MTLBuffer), шейдеры
+// (glmtl_shaders.cpp). Текстуры, кадровые буферы, состояние и рисование —
+// в glmtl_render.mm. Всё, что не реализовано, — общая заглушка.
+
+#include "glmtl_internal.h"
+#include "glmtl_shaders.h"
+
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+
+namespace
+{
+struct MtlState
+{
+    GLuint nextName = 1;
+    std::unordered_map<GLenum, GLuint> boundBuffer; // цель → имя буфера
+    std::unordered_map<GLuint, id<MTLBuffer>> buffers;
+} g;
+
+using xr_mtl::core;
+
+const char* const kExtensions[] = {
+    "GL_KHR_texture_compression_astc_ldr",
+    "GL_EXT_color_buffer_half_float",
+    "GL_APPLE_texture_format_BGRA8888",
+};
+
+// --- общие заглушки ---------------------------------------------------------
+GLuint64 gl_noop() { return 0; }
+
+GLenum gl_GetError() { return GL_NO_ERROR; }
+
+const GLubyte* gl_GetString(GLenum name)
+{
+    switch (name)
+    {
+    case GL_VENDOR: return (const GLubyte*)"Apple Inc. (iOSRay Metal)";
+    case GL_RENDERER: return (const GLubyte*)(core.device ? core.device.name.UTF8String : "Metal");
+    case GL_VERSION: return (const GLubyte*)"OpenGL ES 3.0 iOSRay-Metal";
+    case GL_SHADING_LANGUAGE_VERSION: return (const GLubyte*)"OpenGL ES GLSL ES 3.00";
+    default: return (const GLubyte*)"";
+    }
+}
+
+const GLubyte* gl_GetStringi(GLenum name, GLuint index)
+{
+    if (name == GL_EXTENSIONS && index < std::size(kExtensions))
+        return (const GLubyte*)kExtensions[index];
+    return (const GLubyte*)"";
+}
+
+void gl_GetIntegerv(GLenum pname, GLint* v)
+{
+    switch (pname)
+    {
+    case GL_NUM_EXTENSIONS: *v = GLint(std::size(kExtensions)); return;
+    case GL_MAJOR_VERSION: *v = 3; return;
+    case GL_MINOR_VERSION: *v = 0; return;
+    case GL_MAX_TEXTURE_SIZE: *v = 8192; return;
+    case GL_MAX_CUBE_MAP_TEXTURE_SIZE: *v = 8192; return;
+    case GL_MAX_3D_TEXTURE_SIZE: *v = 2048; return;
+    case GL_MAX_ARRAY_TEXTURE_LAYERS: *v = 2048; return;
+    case GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS: *v = 16; return;
+    case GL_MAX_TEXTURE_IMAGE_UNITS: *v = 16; return;
+    case GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS: *v = 32; return;
+    case GL_MAX_VERTEX_ATTRIBS: *v = 16; return;
+    case GL_MAX_DRAW_BUFFERS: *v = 4; return;
+    case GL_MAX_COLOR_ATTACHMENTS: *v = 4; return;
+    case GL_MAX_SAMPLES: *v = 4; return;
+    case GL_MAX_RENDERBUFFER_SIZE: *v = 8192; return;
+    case GL_MAX_UNIFORM_BLOCK_SIZE: *v = 65536; return;
+    case GL_UNIFORM_BUFFER_OFFSET_ALIGNMENT: *v = 16; return;
+    case GL_MAX_VERTEX_UNIFORM_VECTORS: *v = 1024; return;
+    case GL_MAX_FRAGMENT_UNIFORM_VECTORS: *v = 1024; return;
+    case GL_VIEWPORT:
+        v[0] = v[1] = 0;
+        v[2] = core.layer ? GLint(core.layer.drawableSize.width) : 1;
+        v[3] = core.layer ? GLint(core.layer.drawableSize.height) : 1;
+        return;
+    default: *v = 0; return;
+    }
+}
+
+void gl_GetFloatv(GLenum pname, GLfloat* v)
+{
+    GLint i[4]{};
+    gl_GetIntegerv(pname, i);
+    v[0] = GLfloat(i[0]);
+}
+
+void gl_GetBooleanv(GLenum, GLboolean* v) { *v = GL_FALSE; }
+
+GLenum gl_CheckFramebufferStatus(GLenum) { return GL_FRAMEBUFFER_COMPLETE; }
+
+void gl_GenNames(GLsizei n, GLuint* ids)
+{
+    for (GLsizei i = 0; i < n; ++i)
+        ids[i] = g.nextName++;
+}
+
+GLuint gl_CreateName() { return g.nextName++; }
+
+GLuint gl_CreateShaderProgramv(GLenum, GLsizei, const GLchar* const*) { return g.nextName++; }
+
+// --- шейдеры и программы (этап 4): см. glmtl_shaders.cpp ----------------------
+GLuint gl_CreateShader(GLenum type)
+{
+    const GLuint id = g.nextName++;
+    xr_mtl::CreateShader(id, type);
+    return id;
+}
+void gl_ShaderSource(GLuint id, GLsizei n, const GLchar* const* s, const GLint* l) { xr_mtl::ShaderSource(id, n, s, l); }
+void gl_DeleteShader(GLuint id) { xr_mtl::DeleteShader(id); }
+GLuint gl_CreateProgram()
+{
+    const GLuint id = g.nextName++;
+    xr_mtl::CreateProgram(id);
+    return id;
+}
+void gl_DeleteProgram(GLuint id) { xr_mtl::DeleteProgram(id); }
+void gl_AttachShader(GLuint p, GLuint s) { xr_mtl::AttachShader(p, s); }
+void gl_DetachShader(GLuint p, GLuint s) { xr_mtl::DetachShader(p, s); }
+void gl_LinkProgram(GLuint p) { xr_mtl::LinkProgram(p); }
+void gl_UseProgram(GLuint p) { xr_mtl::UseProgram(p); }
+void gl_GetActiveUniform(GLuint p, GLuint i, GLsizei b, GLsizei* l, GLint* sz, GLenum* t, GLchar* n)
+{
+    xr_mtl::GetActiveUniform(p, i, b, l, sz, t, n);
+}
+
+// Компиляция откладывается до линковки: там видны обе стадии сразу
+void gl_GetShaderiv(GLuint, GLenum pname, GLint* v)
+{
+    *v = (pname == GL_COMPILE_STATUS) ? GL_TRUE : 0;
+}
+
+void gl_GetProgramiv(GLuint p, GLenum pname, GLint* v) { xr_mtl::GetProgramiv(p, pname, v); }
+
+void gl_GetProgramPipelineiv(GLuint, GLenum pname, GLint* v)
+{
+    *v = (pname == GL_VALIDATE_STATUS) ? GL_TRUE : 0;
+}
+
+void gl_GetInfoLog(GLuint, GLsizei bufSize, GLsizei* length, GLchar* log)
+{
+    if (length)
+        *length = 0;
+    if (log && bufSize > 0)
+        log[0] = 0;
+}
+
+GLint gl_GetUniformLocation(GLuint p, const GLchar* n) { return xr_mtl::GetUniformLocation(p, n); }
+
+// glUniform* / glProgramUniform*: пишем в теневые блоки программы
+#define XR_U_SCALAR(N, T, ...)                                                   \
+    void gl_Uniform##N(GLint l, __VA_ARGS__)                                     \
+    {                                                                            \
+        const T v[] = { XR_U_ARGS_##N };                                         \
+        xr_mtl::SetUniform(0, l, 1, v, 1, sizeof(v) / sizeof(T), false);        \
+    }                                                                            \
+    void gl_ProgramUniform##N(GLuint p, GLint l, __VA_ARGS__)                    \
+    {                                                                            \
+        const T v[] = { XR_U_ARGS_##N };                                         \
+        xr_mtl::SetUniform(p, l, 1, v, 1, sizeof(v) / sizeof(T), false);        \
+    }
+#define XR_U_ARGS_1f x
+#define XR_U_ARGS_2f x, y
+#define XR_U_ARGS_3f x, y, z
+#define XR_U_ARGS_4f x, y, z, w
+#define XR_U_ARGS_1i x
+#define XR_U_ARGS_2i x, y
+#define XR_U_ARGS_3i x, y, z
+#define XR_U_ARGS_4i x, y, z, w
+XR_U_SCALAR(1f, GLfloat, GLfloat x)
+XR_U_SCALAR(2f, GLfloat, GLfloat x, GLfloat y)
+XR_U_SCALAR(3f, GLfloat, GLfloat x, GLfloat y, GLfloat z)
+XR_U_SCALAR(4f, GLfloat, GLfloat x, GLfloat y, GLfloat z, GLfloat w)
+XR_U_SCALAR(1i, GLint, GLint x)
+XR_U_SCALAR(2i, GLint, GLint x, GLint y)
+XR_U_SCALAR(3i, GLint, GLint x, GLint y, GLint z)
+XR_U_SCALAR(4i, GLint, GLint x, GLint y, GLint z, GLint w)
+
+#define XR_U_VEC(N, T, R)                                                                                      \
+    void gl_Uniform##N##v(GLint l, GLsizei c, const T* v) { xr_mtl::SetUniform(0, l, c, v, 1, R, false); }   \
+    void gl_ProgramUniform##N##v(GLuint p, GLint l, GLsizei c, const T* v) { xr_mtl::SetUniform(p, l, c, v, 1, R, false); }
+XR_U_VEC(1f, GLfloat, 1)
+XR_U_VEC(2f, GLfloat, 2)
+XR_U_VEC(3f, GLfloat, 3)
+XR_U_VEC(4f, GLfloat, 4)
+XR_U_VEC(1i, GLint, 1)
+XR_U_VEC(2i, GLint, 2)
+XR_U_VEC(3i, GLint, 3)
+XR_U_VEC(4i, GLint, 4)
+
+// MatrixCxR: C столбцов, R строк
+#define XR_U_MAT(N, C, R)                                                                                    \
+    void gl_UniformMatrix##N##fv(GLint l, GLsizei c, GLboolean t, const GLfloat* v)                          \
+    {                                                                                                        \
+        xr_mtl::SetUniform(0, l, c, v, C, R, t == GL_TRUE);                                                  \
+    }                                                                                                        \
+    void gl_ProgramUniformMatrix##N##fv(GLuint p, GLint l, GLsizei c, GLboolean t, const GLfloat* v)         \
+    {                                                                                                        \
+        xr_mtl::SetUniform(p, l, c, v, C, R, t == GL_TRUE);                                                  \
+    }
+XR_U_MAT(2, 2, 2)
+XR_U_MAT(3, 3, 3)
+XR_U_MAT(4, 4, 4)
+XR_U_MAT(4x2, 4, 2)
+XR_U_MAT(4x3, 4, 3)
+XR_U_MAT(3x4, 3, 4)
+XR_U_MAT(2x4, 2, 4)
+GLint gl_GetAttribLocation(GLuint, const GLchar*) { return -1; }
+GLuint gl_GetUniformBlockIndex(GLuint, const GLchar*) { return GL_INVALID_INDEX; }
+
+GLsync gl_FenceSync(GLenum, GLbitfield) { return reinterpret_cast<GLsync>(uintptr_t(1)); }
+GLenum gl_ClientWaitSync(GLsync, GLbitfield, GLuint64) { return GL_ALREADY_SIGNALED; }
+
+void gl_GetQueryObjectuiv(GLuint, GLenum pname, GLuint* v) { *v = pname == GL_QUERY_RESULT_AVAILABLE ? GL_TRUE : 1; }
+
+GLboolean gl_IsTrue(GLuint) { return GL_TRUE; }
+
+// --- буферы: настоящие MTLBuffer, чтобы отображение в память работало -------
+void gl_BindBuffer(GLenum target, GLuint buffer)
+{
+    if (target == GL_ELEMENT_ARRAY_BUFFER)
+        xr_mtl::SetElementBufferBinding(buffer); // привязка индексов — часть VAO
+    else
+    {
+        if (target == GL_ARRAY_BUFFER)
+            xr_mtl::SetArrayBufferBinding(buffer);
+        g.boundBuffer[target] = buffer;
+    }
+}
+
+GLuint BoundName(GLenum target)
+{
+    return target == GL_ELEMENT_ARRAY_BUFFER ? xr_mtl::ElementBufferBinding() : g.boundBuffer[target];
+}
+
+void gl_DeleteBuffers(GLsizei n, const GLuint* ids)
+{
+    for (GLsizei i = 0; i < n; ++i)
+        g.buffers.erase(ids[i]);
+}
+
+id<MTLBuffer> BoundBuffer(GLenum target)
+{
+    const auto it = g.buffers.find(BoundName(target));
+    return it == g.buffers.end() ? nil : it->second;
+}
+
+void gl_BufferData(GLenum target, GLsizeiptr size, const void* data, GLenum)
+{
+    const GLuint name = BoundName(target);
+    if (!name || size <= 0)
+        return;
+    id<MTLBuffer> buf = data ? [core.device newBufferWithBytes:data length:NSUInteger(size) options:MTLResourceStorageModeShared]
+                             : [core.device newBufferWithLength:NSUInteger(size) options:MTLResourceStorageModeShared];
+    g.buffers[name] = buf;
+}
+
+void gl_BufferSubData(GLenum target, GLintptr offset, GLsizeiptr size, const void* data)
+{
+    id<MTLBuffer> buf = BoundBuffer(target);
+    if (buf && data && NSUInteger(offset + size) <= buf.length)
+        memcpy(static_cast<uint8_t*>(buf.contents) + offset, data, size_t(size));
+}
+
+void* gl_MapBufferRange(GLenum target, GLintptr offset, GLsizeiptr length, GLbitfield access)
+{
+    id<MTLBuffer> buf = BoundBuffer(target);
+    if (buf && (access & GL_MAP_INVALIDATE_BUFFER_BIT))
+    {
+        // «осиротить» буфер: GPU может ещё читать старый — отдаём новый
+        buf = [core.device newBufferWithLength:buf.length options:MTLResourceStorageModeShared];
+        g.buffers[BoundName(target)] = buf;
+    }
+    if (!buf || NSUInteger(offset + length) > buf.length)
+        return nullptr;
+    return static_cast<uint8_t*>(buf.contents) + offset;
+}
+
+void* gl_MapBuffer(GLenum target, GLenum)
+{
+    id<MTLBuffer> buf = BoundBuffer(target);
+    return buf ? buf.contents : nullptr;
+}
+
+GLboolean gl_UnmapBuffer(GLenum) { return GL_TRUE; }
+
+void gl_GetBufferParameteriv(GLenum target, GLenum pname, GLint* v)
+{
+    id<MTLBuffer> buf = BoundBuffer(target);
+    *v = (pname == GL_BUFFER_SIZE && buf) ? GLint(buf.length) : 0;
+}
+
+struct Entry
+{
+    const char* name;
+    void* fn;
+};
+
+#define E(n, f) { n, reinterpret_cast<void*>(&f) }
