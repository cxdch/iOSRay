+        t.extent(), t.layers(), t.faces(), t.levels());
+    const size_t blockSize = (k == bc::kind::bc1 || k == bc::kind::bc1a) ? 8 : 16;
+    for (size_t layer = 0; layer < t.layers(); ++layer)
+        for (size_t face = 0; face < t.faces(); ++face)
+            for (size_t level = 0; level < t.levels(); ++level)
+            {
+                const auto e = t.extent(level);
+                const auto* src = static_cast<const uint8_t*>(t.data(layer, face, level));
+                auto* dst = static_cast<uint8_t*>(out.data(layer, face, level));
+                const size_t srcSlice = size_t((e.x + 3) / 4) * size_t((e.y + 3) / 4) * blockSize;
+                const size_t dstSlice = size_t(e.x) * size_t(e.y) * 4;
+                for (int z = 0; z < e.z; ++z)
