+if (CMAKE_SYSTEM_NAME STREQUAL "iOS")
+    enable_language(OBJCXX)
+    target_sources(xr_3da PRIVATE ios_bootstrap.mm ios_touch.mm)
+    set_source_files_properties(ios_bootstrap.mm ios_touch.mm PROPERTIES
+        COMPILE_OPTIONS "-fobjc-arc"
+        SKIP_PRECOMPILE_HEADERS ON
+        SKIP_UNITY_BUILD_INCLUSION ON)
+    target_link_libraries(xr_3da PRIVATE SDL2::SDL2main "-framework Foundation" "-framework UIKit")
+    # На iOS исполняемый файл — это .app-бандл; пакет собирает проект iOSRay.
+    install(TARGETS xr_3da BUNDLE DESTINATION "${CMAKE_INSTALL_BINDIR}")
+else()
+    install(TARGETS xr_3da RUNTIME
+        DESTINATION "${CMAKE_INSTALL_BINDIR}"
+    )
+endif()
