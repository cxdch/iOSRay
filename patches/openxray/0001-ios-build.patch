+#ifdef XR_USE_ASTC
+// ---------------------------------------------------------------------------
+// iOSRay: DXT → ASTC 4x4 (ARM astcenc) с кэшем на диске.
+// Память — как у DXT (8 бит на пиксель), вместо 32 бит у распакованного RGBA8.
+// Первый раз текстура сжимается (медленно), потом читается из
+// $app_data_root$/astc_cache/<ключ>.xra. Кэш можно удалить в любой момент.
+// ---------------------------------------------------------------------------
+namespace
+{
+struct AstcCache
+{
+    astcenc_context* ctx[2]{}; // [0] — UNORM, [1] — sRGB
+    bool initialized = false;
+    bool usable = false;
+    string_path dir{};
+    u32 fromCache = 0, encoded = 0;
+    double encodeSeconds = 0;
+} g_astc;
+
+constexpr unsigned ASTC_THREADS = 2; // у A10 два быстрых ядра
+constexpr u32 XRA_MAGIC = 0x31415258; // "XRA1"
+
+struct XraHeader
+{
+    u32 magic, target, format, w, h, d, layers, faces, levels, size;
+};
+
+bool AstcInit()
+{
+    if (g_astc.initialized)
+        return g_astc.usable;
+    g_astc.initialized = true;
+    if (!GLAD_GL_KHR_texture_compression_astc_ldr)
+    {
+        Msg("! ASTC: GPU не поддерживает ASTC LDR — остаюсь на RGBA8");
+        return false;
+    }
+    for (int i = 0; i < 2; ++i)
+    {
+        astcenc_config cfg{};
+        if (astcenc_config_init(i ? ASTCENC_PRF_LDR_SRGB : ASTCENC_PRF_LDR, 4, 4, 1, ASTCENC_PRE_FASTEST, 0, &cfg)
+                != ASTCENC_SUCCESS
+            || astcenc_context_alloc(&cfg, ASTC_THREADS, &g_astc.ctx[i]) != ASTCENC_SUCCESS)
+        {
+            Msg("! ASTC: не удалось создать кодер astcenc");
+            return false;
+        }
+    }
+    FS.update_path(g_astc.dir, "$app_data_root$", "astc_cache\\");
+    for (char* c = g_astc.dir; *c; ++c)
+        if (*c == '\\')
+            *c = '/';
+    mkdir(g_astc.dir, 0755);
+    Msg("* ASTC: включено, кэш: %s", g_astc.dir);
+    g_astc.usable = true;
+    return true;
+}
+
+u64 Fnv1a(const void* data, size_t n, u64 h = 1469598103934665603ull)
+{
+    const u8* p = static_cast<const u8*>(data);
+    for (size_t i = 0; i < n; ++i)
+        h = (h ^ p[i]) * 1099511628211ull;
+    return h;
+}
+
+void CachePath(string_path& out, pcstr name, size_t fileSize, const gli::texture& t)
+{
+    u64 h = Fnv1a(name, xr_strlen(name));
+    const u32 extra[] = { u32(fileSize), u32(t.levels()), u32(t.extent().x), u32(t.extent().y), u32(t.faces()),
+        u32(t.format()) };
+    h = Fnv1a(extra, sizeof(extra), h);
+    xr_sprintf(out, "%s%016llx.xra", g_astc.dir, (unsigned long long)h);
+}
+
+bool CacheLoad(pcstr path, gli::texture& out)
+{
+    FILE* f = fopen(path, "rb");
+    if (!f)
+        return false;
+    XraHeader hd{};
+    bool ok = fread(&hd, sizeof(hd), 1, f) == 1 && hd.magic == XRA_MAGIC;
+    if (ok)
+    {
+        gli::texture t(gli::target(hd.target), gli::format(hd.format), gli::extent3d(hd.w, hd.h, hd.d), hd.layers,
+            hd.faces, hd.levels);
+        ok = t.size() == hd.size && fread(t.data(), 1, t.size(), f) == t.size();
+        if (ok)
+            out = std::move(t);
+    }
+    fclose(f);
+    return ok;
+}
+
+void CacheSave(pcstr path, const gli::texture& t)
+{
+    string_path tmp;
+    xr_sprintf(tmp, "%s.tmp", path);
+    FILE* f = fopen(tmp, "wb");
+    if (!f)
+        return;
+    const auto e = t.extent();
+    const XraHeader hd{ XRA_MAGIC, u32(t.target()), u32(t.format()), u32(e.x), u32(e.y), u32(e.z), u32(t.layers()),
+        u32(t.faces()), u32(t.levels()), u32(t.size()) };
+    const bool ok = fwrite(&hd, sizeof(hd), 1, f) == 1 && fwrite(t.data(), 1, t.size(), f) == t.size();
+    fclose(f);
+    if (ok)
+        rename(tmp, path);
+    else
+        remove(tmp);
+}
+
+bool EncodeLevel(astcenc_context* ctx, u8* rgba, u32 w, u32 h, u8* out, size_t outSize)
+{
+    void* slices[] = { rgba };
+    astcenc_image img{ w, h, 1, ASTCENC_TYPE_U8, slices };
+    const astcenc_swizzle swz{ ASTCENC_SWZ_R, ASTCENC_SWZ_G, ASTCENC_SWZ_B, ASTCENC_SWZ_A };
+    astcenc_error err0 = ASTCENC_SUCCESS, err1 = ASTCENC_SUCCESS;
+    if (w * h >= 128 * 128)
+    {
+        std::thread helper([&] { err1 = astcenc_compress_image(ctx, &img, &swz, out, outSize, 1); });
+        err0 = astcenc_compress_image(ctx, &img, &swz, out, outSize, 0);
+        helper.join();
+    }
+    else
+        err0 = astcenc_compress_image(ctx, &img, &swz, out, outSize, 0);
+    astcenc_compress_reset(ctx);
+    return err0 == ASTCENC_SUCCESS && err1 == ASTCENC_SUCCESS;
+}
