+id<MTLBuffer> BufferObject(GLuint name)
+{
+    const auto it = g.buffers.find(name);
+    return it == g.buffers.end() ? nil : it->second;
+}
+} // namespace xr_mtl
+
+extern "C" bool xr_mtl_init(void* metalLayer)
+{
+    core.device = MTLCreateSystemDefaultDevice();
+    if (!core.device || !metalLayer)
+        return false;
+    core.queue = [core.device newCommandQueue];
+    core.layer = (__bridge CAMetalLayer*)metalLayer;
+    core.layer.device = core.device;
+    core.layer.pixelFormat = MTLPixelFormatBGRA8Unorm;
+    core.layer.framebufferOnly = YES;
+    core.layer.maximumDrawableCount = 3;
+    xr_mtl::RenderInit();
+    printf("[iOSRay] Metal: %s, слой %.0fx%.0f\n", core.device.name.UTF8String, core.layer.drawableSize.width,
+        core.layer.drawableSize.height);
+    fflush(stdout);
+    return true;
+}
+
+// Загрузчик для gladLoadGLES2: свои реализации или общая заглушка
+extern "C" void* xr_mtl_get_proc(const char* name)
+{
+    if (void* fn = xr_mtl::RenderProc(name))
+        return fn;
+    for (const Entry& e : kTable)
+        if (!strcmp(e.name, name))
+            return e.fn;
+    return reinterpret_cast<void*>(&gl_noop);
+}
+
+// Конец кадра: вывод на экран (glmtl_render.mm)
+extern "C" void xr_mtl_present() { xr_mtl::RenderPresent(); }
