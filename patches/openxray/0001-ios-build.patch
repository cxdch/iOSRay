+    E("glUniformMatrix3x4fv", gl_UniformMatrix3x4fv),
+    E("glProgramUniformMatrix3x4fv", gl_ProgramUniformMatrix3x4fv),
+    E("glUniformMatrix2x4fv", gl_UniformMatrix2x4fv),
+    E("glProgramUniformMatrix2x4fv", gl_ProgramUniformMatrix2x4fv),
