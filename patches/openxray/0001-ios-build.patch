diff --git a/src/Layers/xrRenderGL/glBCDecode.h b/src/Layers/xrRenderGL/glBCDecode.h
new file mode 100644
index 00000000..33fe2a04
--- /dev/null
+++ b/src/Layers/xrRenderGL/glBCDecode.h
@@ -0,0 +1,109 @@
+#pragma once
+// Распаковка BC1/BC2/BC3 (DXT1/DXT3/DXT5) в RGBA8 на CPU.
+// Нужна для OpenGL ES на iOS: у GPU Apple A10 и старше нет S3TC, а текстуры игры — в DDS/DXT.
+// Временное решение до перекодировки в ASTC.
+
+#include <cstdint>
+#include <cstring>
+
+namespace xray::render::bc
+{
+inline void rgb565(uint16_t c, uint8_t out[3])
+{
+    const uint32_t r = (c >> 11) & 31, g = (c >> 5) & 63, b = c & 31;
+    out[0] = uint8_t((r * 527 + 23) >> 6);
+    out[1] = uint8_t((g * 259 + 33) >> 6);
+    out[2] = uint8_t((b * 527 + 23) >> 6);
+}
+
+// Цветовой блок (8 байт) → 16 пикселей RGBA.
+// isBC1: при c0 <= c1 блок трёхцветный; punchAlpha: четвёртый цвет прозрачный (DXT1a), иначе чёрный.
+inline void decode_color(const uint8_t* block, uint8_t rgba[16][4], bool isBC1, bool punchAlpha)
+{
+    const uint16_t c0 = uint16_t(block[0] | (block[1] << 8));
+    const uint16_t c1 = uint16_t(block[2] | (block[3] << 8));
+    uint8_t pal[4][4];
+    rgb565(c0, pal[0]);
+    rgb565(c1, pal[1]);
+    pal[0][3] = pal[1][3] = 255;
+    if (c0 > c1 || !isBC1)
+    {
+        for (int k = 0; k < 3; ++k)
+        {
+            pal[2][k] = uint8_t((2 * pal[0][k] + pal[1][k] + 1) / 3);
+            pal[3][k] = uint8_t((pal[0][k] + 2 * pal[1][k] + 1) / 3);
+        }
+        pal[2][3] = pal[3][3] = 255;
+    }
+    else
+    {
+        for (int k = 0; k < 3; ++k)
+        {
+            pal[2][k] = uint8_t((pal[0][k] + pal[1][k] + 1) / 2);
+            pal[3][k] = 0;
+        }
+        pal[2][3] = 255;
+        pal[3][3] = punchAlpha ? 0 : 255;
+    }
+    const uint32_t idx = uint32_t(block[4] | (block[5] << 8) | (block[6] << 16) | (uint32_t(block[7]) << 24));
+    for (int i = 0; i < 16; ++i)
+        std::memcpy(rgba[i], pal[(idx >> (2 * i)) & 3], 4);
+}
+
+inline void decode_alpha_bc2(const uint8_t* block, uint8_t rgba[16][4])
+{
+    for (int i = 0; i < 16; ++i)
+    {
+        const uint8_t a = uint8_t((block[i / 2] >> ((i & 1) * 4)) & 15);
+        rgba[i][3] = uint8_t(a * 17);
+    }
+}
+
+inline void decode_alpha_bc3(const uint8_t* block, uint8_t rgba[16][4])
+{
+    uint8_t a[8];
+    a[0] = block[0];
+    a[1] = block[1];
+    if (a[0] > a[1])
+        for (int i = 1; i < 7; ++i)
+            a[i + 1] = uint8_t(((7 - i) * a[0] + i * a[1] + 3) / 7);
+    else
+    {
+        for (int i = 1; i < 5; ++i)
+            a[i + 1] = uint8_t(((5 - i) * a[0] + i * a[1] + 2) / 5);
+        a[6] = 0;
+        a[7] = 255;
+    }
+    uint64_t bits = 0;
+    for (int i = 0; i < 6; ++i)
+        bits |= uint64_t(block[2 + i]) << (8 * i);
+    for (int i = 0; i < 16; ++i)
+        rgba[i][3] = a[(bits >> (3 * i)) & 7];
+}
+
+enum class kind { bc1, bc1a, bc2, bc3 };
+
+// Распаковывает уровень (width×height) из блоков src в плотный RGBA8 dst (width*height*4 байт).
+inline void decode_level(kind k, const uint8_t* src, uint32_t width, uint32_t height, uint8_t* dst)
+{
+    const uint32_t bw = (width + 3) / 4, bh = (height + 3) / 4;
+    const uint32_t blockSize = (k == kind::bc1 || k == kind::bc1a) ? 8 : 16;
+    uint8_t px[16][4];
+    for (uint32_t by = 0; by < bh; ++by)
+    {
+        for (uint32_t bx = 0; bx < bw; ++bx, src += blockSize)
+        {
+            switch (k)
+            {
+            case kind::bc1: decode_color(src, px, true, false); break;
+            case kind::bc1a: decode_color(src, px, true, true); break;
+            case kind::bc2: decode_color(src + 8, px, false, false); decode_alpha_bc2(src, px); break;
+            case kind::bc3: decode_color(src + 8, px, false, false); decode_alpha_bc3(src, px); break;
+            }
+            for (uint32_t y = 0; y < 4 && by * 4 + y < height; ++y)
+                for (uint32_t x = 0; x < 4 && bx * 4 + x < width; ++x)
+                    std::memcpy(dst + ((by * 4 + y) * width + bx * 4 + x) * 4, px[y * 4 + x], 4);
+        }
+    }
+}
+} // namespace xray::render::bc
