+// OpenGL ES на iOS: у GPU Apple нет S3TC, поэтому DXT1/3/5 распаковываются в RGBA8 при загрузке.
+// Это временно (память ×4–8) — до перекодировки текстур в ASTC.
+static gli::texture DecompressBCIfUnsupported(const gli::texture& t, pcstr name)
+{
+    if (!gli::is_compressed(t.format()) || GLAD_GL_EXT_texture_compression_s3tc)
+        return t;
+    namespace bc = xray::render::bc;
+    bc::kind k;
+    bool srgb = false;
+    switch (t.format())
+    {
+    case gli::FORMAT_RGB_DXT1_SRGB_BLOCK8: srgb = true; [[fallthrough]];
+    case gli::FORMAT_RGB_DXT1_UNORM_BLOCK8: k = bc::kind::bc1; break;
+    case gli::FORMAT_RGBA_DXT1_SRGB_BLOCK8: srgb = true; [[fallthrough]];
+    case gli::FORMAT_RGBA_DXT1_UNORM_BLOCK8: k = bc::kind::bc1a; break;
+    case gli::FORMAT_RGBA_DXT3_SRGB_BLOCK16: srgb = true; [[fallthrough]];
+    case gli::FORMAT_RGBA_DXT3_UNORM_BLOCK16: k = bc::kind::bc2; break;
+    case gli::FORMAT_RGBA_DXT5_SRGB_BLOCK16: srgb = true; [[fallthrough]];
+    case gli::FORMAT_RGBA_DXT5_UNORM_BLOCK16: k = bc::kind::bc3; break;
+    default:
+        Msg("! OpenGL ES: сжатый формат %d не поддерживается: %s", int(t.format()), name);
+        return t;
+    }
