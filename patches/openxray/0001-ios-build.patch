+
+// Вместо распаковки DXT в RGBA8: ASTC из кэша или пересжатие.
+static gli::texture ConvertBCForES(const gli::texture& t, pcstr name, size_t fileSize)
+{
+    if (!gli::is_compressed(t.format()) || GLAD_GL_EXT_texture_compression_s3tc || !AstcInit())
+        return DecompressBCIfUnsupported(t, name);
+
+    string_path cache;
+    CachePath(cache, name, fileSize, t);
+    gli::texture cached;
+    if (CacheLoad(cache, cached))
+    {
+        ++g_astc.fromCache;
+        return cached;
+    }
+
+    const gli::texture rgba = DecompressBCIfUnsupported(t, name);
+    if (gli::is_compressed(rgba.format()))
+        return rgba; // формат, который мы не распаковываем — как есть
+    const bool srgb = rgba.format() == gli::FORMAT_RGBA8_SRGB_PACK8;
+    gli::texture out(rgba.target(), srgb ? gli::FORMAT_RGBA_ASTC_4X4_SRGB_BLOCK16 : gli::FORMAT_RGBA_ASTC_4X4_UNORM_BLOCK16,
+        rgba.extent(), rgba.layers(), rgba.faces(), rgba.levels());
+
+    const auto t0 = std::chrono::steady_clock::now();
+    for (size_t layer = 0; layer < rgba.layers(); ++layer)
+        for (size_t face = 0; face < rgba.faces(); ++face)
+            for (size_t level = 0; level < rgba.levels(); ++level)
+            {
+                const auto e = rgba.extent(level);
+                auto* src = static_cast<u8*>(const_cast<void*>(rgba.data(layer, face, level)));
+                auto* dst = static_cast<u8*>(out.data(layer, face, level));
+                if (!EncodeLevel(g_astc.ctx[srgb ? 1 : 0], src, u32(e.x), u32(e.y), dst, out.size(level)))
+                {
+                    Msg("! ASTC: ошибка сжатия %s — оставляю RGBA8", name);
+                    return rgba;
+                }
+            }
+    g_astc.encodeSeconds += std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    CacheSave(cache, out);
+    if ((++g_astc.encoded % 100) == 1)
+        Msg("* ASTC: сжато %u текстур за %.0f с, из кэша %u", g_astc.encoded, g_astc.encodeSeconds, g_astc.fromCache);
+    return out;
+}
