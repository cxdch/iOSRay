+// --- VAO ----------------------------------------------------------------------------
+GLuint g_arrayBuffer = 0;
+
+void gl_BindVertexArray(GLuint vao) { s.vao = vao; }
+void gl_DeleteVertexArrays(GLsizei n, const GLuint* ids)
+{
+    for (GLsizei i = 0; i < n; ++i)
+        if (ids[i])
+            s.vaos.erase(ids[i]);
+}
+void gl_EnableVertexAttribArray(GLuint i)
+{
+    if (i < kMaxAttribs)
+        s.vaos[s.vao].attribs[i].enabled = true;
+}
+void gl_DisableVertexAttribArray(GLuint i)
+{
+    if (i < kMaxAttribs)
+        s.vaos[s.vao].attribs[i].enabled = false;
+}
+void gl_VertexAttribPointer(GLuint i, GLint size, GLenum type, GLboolean norm, GLsizei stride, const void* ptr)
+{
+    if (i >= kMaxAttribs)
+        return;
+    Attrib& a = s.vaos[s.vao].attribs[i];
+    a.size = size;
+    a.type = type;
+    a.normalized = norm == GL_TRUE;
+    a.stride = stride;
+    a.offset = reinterpret_cast<uintptr_t>(ptr);
+    a.buffer = g_arrayBuffer;
+}
+
+MTLVertexFormat VertexFormatOf(const Attrib& a)
+{
+    switch (a.type)
+    {
+    case GL_FLOAT:
+        return a.size == 1 ? MTLVertexFormatFloat : a.size == 2 ? MTLVertexFormatFloat2
+            : a.size == 3 ? MTLVertexFormatFloat3 : MTLVertexFormatFloat4;
+    case GL_HALF_FLOAT:
+        return a.size <= 2 ? MTLVertexFormatHalf2 : a.size == 3 ? MTLVertexFormatHalf3 : MTLVertexFormatHalf4;
+    case GL_UNSIGNED_BYTE:
+        if (a.normalized)
+            return a.size <= 2 ? MTLVertexFormatUChar2Normalized : a.size == 3 ? MTLVertexFormatUChar3Normalized
+                : MTLVertexFormatUChar4Normalized;
+        return a.size <= 2 ? MTLVertexFormatUChar2 : a.size == 3 ? MTLVertexFormatUChar3 : MTLVertexFormatUChar4;
+    case GL_BYTE:
+        if (a.normalized)
+            return a.size <= 2 ? MTLVertexFormatChar2Normalized : a.size == 3 ? MTLVertexFormatChar3Normalized
+                : MTLVertexFormatChar4Normalized;
+        return a.size <= 2 ? MTLVertexFormatChar2 : a.size == 3 ? MTLVertexFormatChar3 : MTLVertexFormatChar4;
+    case GL_SHORT:
+        if (a.normalized)
+            return a.size <= 2 ? MTLVertexFormatShort2Normalized : a.size == 3 ? MTLVertexFormatShort3Normalized
+                : MTLVertexFormatShort4Normalized;
+        return a.size <= 2 ? MTLVertexFormatShort2 : a.size == 3 ? MTLVertexFormatShort3 : MTLVertexFormatShort4;
+    case GL_UNSIGNED_SHORT:
+        if (a.normalized)
+            return a.size <= 2 ? MTLVertexFormatUShort2Normalized : a.size == 3 ? MTLVertexFormatUShort3Normalized
+                : MTLVertexFormatUShort4Normalized;
+        return a.size <= 2 ? MTLVertexFormatUShort2 : a.size == 3 ? MTLVertexFormatUShort3 : MTLVertexFormatUShort4;
+    default: return MTLVertexFormatFloat4;
+    }
+}
+
+size_t VertexFormatSize(const Attrib& a)
+{
+    size_t c = 4;
+    switch (a.type)
+    {
+    case GL_FLOAT: c = 4; break;
+    case GL_HALF_FLOAT: case GL_SHORT: case GL_UNSIGNED_SHORT: c = 2; break;
+    default: c = 1; break;
+    }
+    return c * size_t(a.size);
+}
