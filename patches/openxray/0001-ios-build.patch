+    E("glGenTextures", gl_GenNames),
+    E("glGenBuffers", gl_GenNames),
+    E("glGenFramebuffers", gl_GenNames),
+    E("glGenRenderbuffers", gl_GenNames),
+    E("glGenVertexArrays", gl_GenNames),
+    E("glGenSamplers", gl_GenNames),
+    E("glGenQueries", gl_GenNames),
+    E("glGenProgramPipelines", gl_GenNames),
+    E("glGenTransformFeedbacks", gl_GenNames),
+    E("glCreateShader", gl_CreateShader),
+    E("glShaderSource", gl_ShaderSource),
+    E("glDeleteShader", gl_DeleteShader),
