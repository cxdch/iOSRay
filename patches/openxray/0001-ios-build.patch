+void gl_ClearColor(GLfloat r, GLfloat g, GLfloat b, GLfloat a)
+{
+    s.clearColor[0] = r; s.clearColor[1] = g; s.clearColor[2] = b; s.clearColor[3] = a;
+}
+void gl_ClearDepthf(GLfloat d) { s.clearDepth = d; }
+void gl_ClearStencil(GLint v) { s.clearStencil = v; }
