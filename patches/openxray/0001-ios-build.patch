+    E("glLinkProgram", gl_LinkProgram),
+    E("glUseProgram", gl_UseProgram),
+    E("glGetActiveUniform", gl_GetActiveUniform),
+    E("glCreateShaderProgramv", gl_CreateShaderProgramv),
+    E("glGetShaderiv", gl_GetShaderiv),
