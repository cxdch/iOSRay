+// iOSRay: Metal-режим, этап 4b — рисование.
+//
+// Здесь GL-вызовы движка превращаются в работу Metal:
+//   * текстуры (glTexStorage*/glTex*SubImage*) → MTLTexture, сэмплеры → MTLSamplerState;
+//   * кадровые буферы (FBO) → наборы вложений прохода рендера;
+//   * VAO + glVertexAttribPointer → MTLVertexDescriptor;
+//   * состояние (смешивание, глубина, трафарет, отсечение, viewport/scissor) →
+//     PSO + MTLDepthStencilState + настройки энкодера;
+//   * glDraw* → drawPrimitives/drawIndexedPrimitives.
+//
+// Раскладка изображений в памяти такая же, как в GL: строка 0 — низ кадра.
+// Для этого шейдеры переворачивают Y (glmtl_shaders.cpp), поэтому viewport/scissor
+// передаются в Metal без пересчёта, обход граней меняется на противоположный,
+// а при выводе на экран кадр переворачивается обратно.
+
+#include "glmtl_internal.h"
+#include "glmtl_shaders.h"
+
+#include <algorithm>
+#include <cstdarg>
+#include <initializer_list>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+namespace xr_mtl
+{
+namespace
+{
+constexpr int kMaxUnits = 32;
+constexpr int kMaxAttribs = 16;
+constexpr int kMaxColor = 4;
+constexpr int kFramesInFlight = 3;
+constexpr NSUInteger kUniformBufferIndex = 0;     // [[buffer(0)]] — gl_DefaultUniformBlock
+constexpr NSUInteger kFirstVertexBufferIndex = 16; // вершинные буферы: 16..29
+constexpr NSUInteger kDummyVertexBufferIndex = 30; // нули для отсутствующих атрибутов
+
+void LogOnce(const std::string& key, const char* fmt, ...) __attribute__((format(printf, 2, 3)));
+std::unordered_set<std::string> g_logged;
+void LogOnce(const std::string& key, const char* fmt, ...)
+{
+    if (!g_logged.insert(key).second || g_logged.size() > 400)
+        return;
+    va_list args;
+    va_start(args, fmt);
+    vprintf(fmt, args);
+    va_end(args);
+    fflush(stdout);
+}
+
+// --- параметры выборки (у текстуры по умолчанию и у объектов-сэмплеров) ----------
+struct SamplerParams
+{
+    int32_t minF = GL_NEAREST_MIPMAP_LINEAR, magF = GL_LINEAR;
+    int32_t wrapS = GL_REPEAT, wrapT = GL_REPEAT, wrapR = GL_REPEAT;
+    int32_t compareMode = GL_NONE, compareFunc = GL_LEQUAL;
+    int32_t maxAniso = 1;
+    int32_t maxLevel = 1000;
+    float minLod = -1000.f, maxLod = 1000.f;
+};
+
+bool operator==(const SamplerParams& a, const SamplerParams& b) { return !memcmp(&a, &b, sizeof(a)); }
+
+struct SamplerParamsHash
+{
+    size_t operator()(const SamplerParams& p) const
+    {
+        const auto* w = reinterpret_cast<const uint32_t*>(&p);
+        size_t h = 0;
+        for (size_t i = 0; i < sizeof(p) / 4; ++i)
+            h = h * 31 + w[i];
+        return h;
+    }
+};
+
+struct Texture
+{
+    GLenum target = 0;
+    GLenum internal = 0;
+    MTLPixelFormat format = MTLPixelFormatInvalid;
+    int w = 0, h = 0, d = 1, levels = 1;
+    id<MTLTexture> mtl = nil;
+    SamplerParams params;
+};
+
+struct Fbo
+{
+    GLuint color[kMaxColor] = {};
+    GLint colorLevel[kMaxColor] = {};
+    GLuint depth = 0, stencil = 0;
+    GLenum drawBuffers[kMaxColor] = { GL_COLOR_ATTACHMENT0, GL_NONE, GL_NONE, GL_NONE };
+};
+
+struct Attrib
+{
+    bool enabled = false;
+    GLint size = 4;
+    GLenum type = GL_FLOAT;
+    bool normalized = false;
+    GLsizei stride = 0;
+    uintptr_t offset = 0;
+    GLuint buffer = 0;
+};
+
+struct Vao
+{
+    Attrib attribs[kMaxAttribs];
+    GLuint elementBuffer = 0;
+};
+
+struct StencilFace
+{
+    GLenum func = GL_ALWAYS;
+    GLint ref = 0;
+    GLuint readMask = 0xFFFFFFFF, writeMask = 0xFFFFFFFF;
+    GLenum sfail = GL_KEEP, dpfail = GL_KEEP, dppass = GL_KEEP;
+};
+
+struct State
+{
+    // объекты
+    std::unordered_map<GLuint, Texture> textures;
+    std::unordered_map<GLuint, SamplerParams> samplers;
+    std::unordered_map<GLuint, Fbo> fbos;
+    std::unordered_map<GLuint, Vao> vaos;
+    std::unordered_map<GLuint, Texture> renderbuffers;
+
+    // привязки
+    GLuint activeUnit = 0;
+    GLuint unit2D[kMaxUnits] = {}, unit3D[kMaxUnits] = {}, unitCube[kMaxUnits] = {}, unitArray[kMaxUnits] = {};
+    GLuint unitSampler[kMaxUnits] = {};
+    GLuint drawFbo = 0, readFbo = 0;
+    GLuint vao = 0;
+    GLuint renderbuffer = 0;
+    GLint unpackAlignment = 4;
+
+    // фиксированное состояние
+    bool blend = false, depthTest = false, stencilTest = false, cull = false, scissorTest = false;
+    bool polygonOffsetFill = false;
+    GLenum blendSrcRGB = GL_ONE, blendDstRGB = GL_ZERO, blendSrcA = GL_ONE, blendDstA = GL_ZERO;
+    GLenum blendEqRGB = GL_FUNC_ADD, blendEqA = GL_FUNC_ADD;
+    float blendColor[4] = {};
+    bool colorMask[4] = { true, true, true, true };
+    GLenum depthFunc = GL_LESS;
+    bool depthMask = true;
+    StencilFace stFront, stBack;
+    GLenum cullFace = GL_BACK, frontFace = GL_CCW;
+    GLint viewport[4] = {};
+    GLint scissor[4] = {};
+    float depthNear = 0.f, depthFar = 1.f;
+    float clearColor[4] = {};
+    float clearDepth = 1.f;
+    GLint clearStencil = 0;
+    float polyFactor = 0.f, polyUnits = 0.f;
+
+    // кадр
+    id<MTLCommandBuffer> cmd = nil;
+    id<MTLRenderCommandEncoder> enc = nil;
+    std::string encKey;
+    id<MTLTexture> encColor[kMaxColor] = {};
+    id<MTLTexture> encDepth = nil;
+    id<MTLTexture> presentSource = nil;
+    dispatch_semaphore_t inFlight;
+    unsigned frameIndex = 0;
+
+    // временная память кадра (uniform-блоки, выровненные индексы)
+    struct Ring
+    {
+        std::vector<id<MTLBuffer>> chunks;
+        size_t chunk = 0, offset = 0;
+    } rings[kFramesInFlight];
+
+    // кэши
+    std::unordered_map<SamplerParams, id<MTLSamplerState>, SamplerParamsHash> samplerStates;
+    std::unordered_map<std::string, id<MTLRenderPipelineState>> pipelines;
+    std::unordered_map<std::string, id<MTLDepthStencilState>> depthStates;
+    struct Lib
+    {
+        uint32_t generation = 0;
+        id<MTLFunction> fn[2] = { nil, nil };
+        bool failed = false;
+    };
+    std::unordered_map<GLuint, Lib> libraries;
+    id<MTLTexture> dummy2D, dummy3D, dummyCube, dummyDepth, dummyArray;
+    id<MTLBuffer> dummyVertex;
+    id<MTLRenderPipelineState> blitPipeline;
+    id<MTLSamplerState> blitSampler;
+
+    // статистика
+    unsigned draws = 0, skipped = 0, passes = 0;
+} s;
+
+// --- форматы ------------------------------------------------------------------
+MTLPixelFormat PixelFormatOf(GLenum internal)
+{
+    switch (internal)
+    {
+    case GL_RGBA8: case GL_RGBA: case GL_RGB8: case GL_RGB: return MTLPixelFormatRGBA8Unorm;
+    case GL_SRGB8_ALPHA8: case GL_SRGB8: return MTLPixelFormatRGBA8Unorm_sRGB;
+    case 0x93A1: /* GL_BGRA8_EXT */ case 0x80E1: /* GL_BGRA_EXT */ return MTLPixelFormatBGRA8Unorm;
+    case GL_R8: case GL_RED: case GL_LUMINANCE: case GL_ALPHA: return MTLPixelFormatR8Unorm;
+    case GL_RG8: case GL_RG: case GL_LUMINANCE_ALPHA: return MTLPixelFormatRG8Unorm;
+    case GL_RGB10_A2: return MTLPixelFormatRGB10A2Unorm;
+    case GL_R16F: return MTLPixelFormatR16Float;
+    case GL_RG16F: return MTLPixelFormatRG16Float;
+    case GL_RGBA16F: case GL_RGB16F: return MTLPixelFormatRGBA16Float;
+    case GL_R32F: return MTLPixelFormatR32Float;
+    case GL_RG32F: return MTLPixelFormatRG32Float;
+    case GL_RGBA32F: case GL_RGB32F: return MTLPixelFormatRGBA32Float;
+    case 0x822A: /* GL_R16 */ return MTLPixelFormatR16Unorm;
+    case 0x822C: /* GL_RG16 */ return MTLPixelFormatRG16Unorm;
+    case 0x805B: /* GL_RGBA16 */ return MTLPixelFormatRGBA16Unorm;
+    case GL_RGB565: case GL_RGBA4: case GL_RGB5_A1: return MTLPixelFormatRGBA8Unorm; // распаковываем
+    case GL_R11F_G11F_B10F: return MTLPixelFormatRG11B10Float;
+    case GL_DEPTH_COMPONENT16: return MTLPixelFormatDepth16Unorm;
+    case GL_DEPTH_COMPONENT24: case GL_DEPTH_COMPONENT32F: case GL_DEPTH_COMPONENT: return MTLPixelFormatDepth32Float;
+    case GL_DEPTH24_STENCIL8: case GL_DEPTH32F_STENCIL8: case GL_DEPTH_STENCIL: return MTLPixelFormatDepth32Float_Stencil8;
+    case GL_STENCIL_INDEX8: return MTLPixelFormatStencil8;
+    case 0x93B0: /* GL_COMPRESSED_RGBA_ASTC_4x4_KHR */ return MTLPixelFormatASTC_4x4_LDR;
+    case 0x93D0: /* GL_COMPRESSED_SRGB8_ALPHA8_ASTC_4x4_KHR */ return MTLPixelFormatASTC_4x4_sRGB;
+    default:
+        LogOnce("fmt" + std::to_string(internal), "! [iOSRay] Metal: формат текстуры 0x%x не знаю — RGBA8\n", internal);
+        return MTLPixelFormatRGBA8Unorm;
+    }
+}
+
+bool IsDepth(MTLPixelFormat f)
+{
+    return f == MTLPixelFormatDepth16Unorm || f == MTLPixelFormatDepth32Float || f == MTLPixelFormatDepth32Float_Stencil8
+        || f == MTLPixelFormatStencil8;
+}
+bool HasStencil(MTLPixelFormat f) { return f == MTLPixelFormatDepth32Float_Stencil8 || f == MTLPixelFormatStencil8; }
+bool IsAstc(MTLPixelFormat f) { return f == MTLPixelFormatASTC_4x4_LDR || f == MTLPixelFormatASTC_4x4_sRGB; }
+bool IsBlendable(MTLPixelFormat f)
+{
+    // A10 (Apple3) не смешивает 32-битные float-форматы
+    return f != MTLPixelFormatR32Float && f != MTLPixelFormatRG32Float && f != MTLPixelFormatRGBA32Float;
+}
+
+size_t BytesPerPixel(MTLPixelFormat f)
+{
+    switch (f)
+    {
+    case MTLPixelFormatR8Unorm: return 1;
+    case MTLPixelFormatRG8Unorm: case MTLPixelFormatR16Float: case MTLPixelFormatR16Unorm:
+    case MTLPixelFormatDepth16Unorm: return 2;
+    case MTLPixelFormatRGBA16Float: case MTLPixelFormatRG32Float: case MTLPixelFormatRGBA16Unorm: return 8;
+    case MTLPixelFormatRGBA32Float: return 16;
+    default: return 4;
+    }
+}
+
+size_t ExternalBytesPerPixel(GLenum format, GLenum type)
+{
+    size_t comps = 4;
+    switch (format)
+    {
+    case GL_RED: case GL_LUMINANCE: case GL_ALPHA: case GL_RED_INTEGER: comps = 1; break;
+    case GL_RG: case GL_LUMINANCE_ALPHA: case GL_RG_INTEGER: comps = 2; break;
+    case GL_RGB: case GL_RGB_INTEGER: comps = 3; break;
+    default: comps = 4; break;
+    }
+    switch (type)
+    {
+    case GL_UNSIGNED_SHORT_5_6_5: case GL_UNSIGNED_SHORT_4_4_4_4: case GL_UNSIGNED_SHORT_5_5_5_1: return 2;
+    case GL_UNSIGNED_INT_2_10_10_10_REV: case GL_UNSIGNED_INT_10F_11F_11F_REV: case GL_UNSIGNED_INT_24_8: return 4;
+    case GL_HALF_FLOAT: case GL_UNSIGNED_SHORT: case GL_SHORT: return comps * 2;
+    case GL_FLOAT: case GL_UNSIGNED_INT: case GL_INT: return comps * 4;
+    default: return comps;
+    }
+}
+
+// Пиксели GL (format/type) → байты формата Metal. Возвращает указатель на готовые данные.
+const void* ConvertPixels(const void* src, size_t pixels, GLenum format, GLenum type, MTLPixelFormat dst,
+    std::vector<uint8_t>& tmp)
+{
+    const size_t outBpp = BytesPerPixel(dst);
+    const auto* in = static_cast<const uint8_t*>(src);
+    if (dst == MTLPixelFormatRGBA8Unorm || dst == MTLPixelFormatRGBA8Unorm_sRGB || dst == MTLPixelFormatBGRA8Unorm)
+    {
+        if (type == GL_UNSIGNED_BYTE && (format == GL_RGBA || format == 0x80E1 /*BGRA*/))
+            return src;
+        tmp.resize(pixels * 4);
+        uint8_t* o = tmp.data();
+        for (size_t i = 0; i < pixels; ++i, o += 4)
+        {
+            if (type == GL_UNSIGNED_BYTE && format == GL_RGB)
+            {
+                o[0] = in[i * 3]; o[1] = in[i * 3 + 1]; o[2] = in[i * 3 + 2]; o[3] = 255;
+            }
+            else if (type == GL_UNSIGNED_SHORT_5_6_5)
+            {
+                const uint16_t v = reinterpret_cast<const uint16_t*>(in)[i];
+                o[0] = uint8_t(((v >> 11) & 31) * 255 / 31); o[1] = uint8_t(((v >> 5) & 63) * 255 / 63);
+                o[2] = uint8_t((v & 31) * 255 / 31); o[3] = 255;
+            }
+            else if (type == GL_UNSIGNED_SHORT_4_4_4_4)
+            {
+                const uint16_t v = reinterpret_cast<const uint16_t*>(in)[i];
+                o[0] = uint8_t(((v >> 12) & 15) * 17); o[1] = uint8_t(((v >> 8) & 15) * 17);
+                o[2] = uint8_t(((v >> 4) & 15) * 17); o[3] = uint8_t((v & 15) * 17);
+            }
+            else if (type == GL_UNSIGNED_SHORT_5_5_5_1)
+            {
+                const uint16_t v = reinterpret_cast<const uint16_t*>(in)[i];
+                o[0] = uint8_t(((v >> 11) & 31) * 255 / 31); o[1] = uint8_t(((v >> 6) & 31) * 255 / 31);
+                o[2] = uint8_t(((v >> 1) & 31) * 255 / 31); o[3] = (v & 1) ? 255 : 0;
+            }
+            else if (type == GL_UNSIGNED_BYTE && (format == GL_LUMINANCE || format == GL_RED))
+            {
+                o[0] = o[1] = o[2] = in[i]; o[3] = 255;
+            }
+            else if (type == GL_UNSIGNED_BYTE && format == GL_LUMINANCE_ALPHA)
+            {
+                o[0] = o[1] = o[2] = in[i * 2]; o[3] = in[i * 2 + 1];
+            }
+            else
+            {
+                o[0] = o[1] = o[2] = o[3] = 255;
+            }
+        }
+        return tmp.data();
+    }
+    // RGB float/half → RGBA
+    if (format == GL_RGB && (dst == MTLPixelFormatRGBA16Float || dst == MTLPixelFormatRGBA32Float))
+    {
+        const size_t c = dst == MTLPixelFormatRGBA16Float ? 2 : 4;
+        tmp.assign(pixels * outBpp, 0);
+        for (size_t i = 0; i < pixels; ++i)
+        {
+            memcpy(&tmp[i * outBpp], in + i * 3 * c, 3 * c);
+            if (c == 2)
+                *reinterpret_cast<uint16_t*>(&tmp[i * outBpp + 6]) = 0x3C00; // 1.0h
+            else
+                *reinterpret_cast<float*>(&tmp[i * outBpp + 12]) = 1.f;
+        }
+        return tmp.data();
+    }
+    return src;
+}
+
+id<MTLTexture> MakeTexture(MTLTextureType type, MTLPixelFormat fmt, int w, int h, int d, int levels)
+{
+    MTLTextureDescriptor* td = [MTLTextureDescriptor new];
+    td.textureType = type;
+    td.pixelFormat = fmt;
+    td.width = NSUInteger(std::max(w, 1));
+    td.height = NSUInteger(std::max(h, 1));
+    td.depth = type == MTLTextureType3D ? NSUInteger(std::max(d, 1)) : 1;
+    td.arrayLength = type == MTLTextureType2DArray ? NSUInteger(std::max(d, 1)) : 1;
+    td.mipmapLevelCount = NSUInteger(std::max(levels, 1));
+    td.usage = MTLTextureUsageShaderRead;
+    if (!IsAstc(fmt) && type != MTLTextureType3D)
+        td.usage |= MTLTextureUsageRenderTarget;
+    td.storageMode = IsDepth(fmt) ? MTLStorageModePrivate : MTLStorageModeShared;
+    return [core.device newTextureWithDescriptor:td];
+}
+
+// --- текстуры -------------------------------------------------------------------
+GLuint& UnitSlot(GLenum target, GLuint unit)
+{
+    switch (target)
+    {
+    case GL_TEXTURE_3D: return s.unit3D[unit];
+    case GL_TEXTURE_CUBE_MAP: return s.unitCube[unit];
+    case GL_TEXTURE_2D_ARRAY: return s.unitArray[unit];
+    default: return s.unit2D[unit];
+    }
+}
+
+Texture* BoundTexture(GLenum target)
+{
+    if (target >= GL_TEXTURE_CUBE_MAP_POSITIVE_X && target <= GL_TEXTURE_CUBE_MAP_NEGATIVE_Z)
+        target = GL_TEXTURE_CUBE_MAP;
+    const GLuint name = UnitSlot(target, s.activeUnit);
+    const auto it = s.textures.find(name);
+    return it == s.textures.end() ? nullptr : &it->second;
+}
+
+void gl_ActiveTexture(GLenum unit) { s.activeUnit = std::min<GLuint>(unit - GL_TEXTURE0, kMaxUnits - 1); }
+
+void gl_BindTexture(GLenum target, GLuint name)
+{
+    UnitSlot(target, s.activeUnit) = name;
+    if (name)
+    {
+        Texture& t = s.textures[name];
+        if (!t.target)
+            t.target = target;
+    }
+}
+
+void gl_DeleteTextures(GLsizei n, const GLuint* names)
+{
+    for (GLsizei i = 0; i < n; ++i)
+        s.textures.erase(names[i]);
+}
+
+MTLTextureType TypeOf(GLenum target)
+{
+    switch (target)
+    {
+    case GL_TEXTURE_3D: return MTLTextureType3D;
+    case GL_TEXTURE_CUBE_MAP: return MTLTextureTypeCube;
+    case GL_TEXTURE_2D_ARRAY: return MTLTextureType2DArray;
+    default: return MTLTextureType2D;
+    }
+}
+
+void Allocate(Texture& t, GLenum target, GLsizei levels, GLenum internal, GLsizei w, GLsizei h, GLsizei d)
+{
+    t.target = target;
+    t.internal = internal;
+    t.format = PixelFormatOf(internal);
+    t.w = w;
+    t.h = h;
+    t.d = d;
+    t.levels = levels;
+    t.mtl = MakeTexture(TypeOf(target), t.format, w, h, d, levels);
+    if (!t.mtl)
+        LogOnce("tex" + std::to_string(w) + "x" + std::to_string(h) + "f" + std::to_string(internal),
+            "! [iOSRay] Metal: не создать текстуру %dx%dx%d формат 0x%x\n", w, h, d, internal);
+}
+
+void gl_TexStorage2D(GLenum target, GLsizei levels, GLenum internal, GLsizei w, GLsizei h)
+{
+    if (Texture* t = BoundTexture(target))
+        Allocate(*t, target, levels, internal, w, h, 1);
+}
+
+void gl_TexStorage3D(GLenum target, GLsizei levels, GLenum internal, GLsizei w, GLsizei h, GLsizei d)
+{
+    if (Texture* t = BoundTexture(target))
+        Allocate(*t, target, levels, internal, w, h, d);
+}
+
+void Upload(Texture& t, GLint level, GLint x, GLint y, GLint z, GLsizei w, GLsizei h, GLsizei d, NSUInteger slice,
+    GLenum format, GLenum type, const void* data, bool compressed, GLsizei compressedSize)
+{
+    if (!t.mtl || !data || level >= t.levels || t.mtl.storageMode == MTLStorageModePrivate)
+        return;
+    const MTLRegion region = MTLRegionMake3D(NSUInteger(x), NSUInteger(y), NSUInteger(z), NSUInteger(w),
+        NSUInteger(h), NSUInteger(std::max(d, 1)));
+    if (compressed)
+    {
+        if (!IsAstc(t.format))
+            return;
+        const NSUInteger bpr = NSUInteger((w + 3) / 4) * 16;
+        const NSUInteger bpi = bpr * NSUInteger((h + 3) / 4);
+        if (NSUInteger(compressedSize) < bpi * NSUInteger(std::max(d, 1)))
+            return;
+        [t.mtl replaceRegion:region mipmapLevel:NSUInteger(level) slice:slice withBytes:data bytesPerRow:bpr
+               bytesPerImage:t.mtl.textureType == MTLTextureType3D ? bpi : 0];
+        return;
+    }
+    if (IsAstc(t.format))
+        return;
+    std::vector<uint8_t> tmp;
+    const size_t pixels = size_t(w) * size_t(h) * size_t(std::max(d, 1));
+    // GL_UNPACK_ALIGNMENT: строки исходника выровнены
+    const size_t inBpp = ExternalBytesPerPixel(format, type);
+    const size_t inRow = (size_t(w) * inBpp + size_t(s.unpackAlignment) - 1) / size_t(s.unpackAlignment)
+        * size_t(s.unpackAlignment);
+    const void* src = data;
+    std::vector<uint8_t> packed;
+    if (inRow != size_t(w) * inBpp)
+    {
+        packed.resize(size_t(w) * inBpp * size_t(h) * size_t(std::max(d, 1)));
+        for (size_t r = 0; r < size_t(h) * size_t(std::max(d, 1)); ++r)
+            memcpy(&packed[r * size_t(w) * inBpp], static_cast<const uint8_t*>(data) + r * inRow, size_t(w) * inBpp);
+        src = packed.data();
+    }
+    src = ConvertPixels(src, pixels, format, type, t.format, tmp);
+    const NSUInteger bpr = NSUInteger(w) * BytesPerPixel(t.format);
+    [t.mtl replaceRegion:region mipmapLevel:NSUInteger(level) slice:slice withBytes:src bytesPerRow:bpr
+           bytesPerImage:t.mtl.textureType == MTLTextureType3D ? bpr * NSUInteger(h) : 0];
+}
+
+NSUInteger SliceOf(GLenum target)
+{
+    return target >= GL_TEXTURE_CUBE_MAP_POSITIVE_X && target <= GL_TEXTURE_CUBE_MAP_NEGATIVE_Z
+        ? NSUInteger(target - GL_TEXTURE_CUBE_MAP_POSITIVE_X)
+        : 0;
+}
+
+void gl_TexImage2D(GLenum target, GLint level, GLint internal, GLsizei w, GLsizei h, GLint, GLenum format,
+    GLenum type, const void* data)
+{
+    Texture* t = BoundTexture(target);
+    if (!t)
+        return;
+    if (level == 0 && (!t->mtl || t->w != w || t->h != h || t->internal != GLenum(internal)))
+    {
+        const GLenum allocTarget = SliceOf(target) || target == GL_TEXTURE_CUBE_MAP_POSITIVE_X ? GL_TEXTURE_CUBE_MAP : target;
+        Allocate(*t, allocTarget, 1, GLenum(internal), w, h, 1);
+    }
+    Upload(*t, level, 0, 0, 0, w, h, 1, SliceOf(target), format, type, data, false, 0);
+}
+
+void gl_TexSubImage2D(GLenum target, GLint level, GLint x, GLint y, GLsizei w, GLsizei h, GLenum format, GLenum type,
+    const void* data)
+{
+    if (Texture* t = BoundTexture(target))
+        Upload(*t, level, x, y, 0, w, h, 1, SliceOf(target), format, type, data, false, 0);
+}
+
+void gl_TexSubImage3D(GLenum target, GLint level, GLint x, GLint y, GLint z, GLsizei w, GLsizei h, GLsizei d,
+    GLenum format, GLenum type, const void* data)
+{
+    Texture* t = BoundTexture(target);
+    if (!t)
+        return;
+    if (target == GL_TEXTURE_3D)
+        Upload(*t, level, x, y, z, w, h, d, 0, format, type, data, false, 0);
+    else // массив: по слою
+    {
+        const size_t layer = size_t(w) * size_t(h) * ExternalBytesPerPixel(format, type);
+        for (GLsizei i = 0; i < d; ++i)
+            Upload(*t, level, x, y, 0, w, h, 1, NSUInteger(z + i), format, type,
+                static_cast<const uint8_t*>(data) + layer * size_t(i), false, 0);
+    }
+}
+
+void gl_CompressedTexImage2D(GLenum target, GLint level, GLenum internal, GLsizei w, GLsizei h, GLint, GLsizei size,
+    const void* data)
+{
+    Texture* t = BoundTexture(target);
+    if (!t)
+        return;
+    if (level == 0 && (!t->mtl || t->w != w || t->h != h))
+        Allocate(*t, SliceOf(target) || target == GL_TEXTURE_CUBE_MAP_POSITIVE_X ? GL_TEXTURE_CUBE_MAP : target, 1,
+            internal, w, h, 1);
+    Upload(*t, level, 0, 0, 0, w, h, 1, SliceOf(target), 0, 0, data, true, size);
+}
+
+void gl_CompressedTexSubImage2D(GLenum target, GLint level, GLint x, GLint y, GLsizei w, GLsizei h, GLenum,
+    GLsizei size, const void* data)
+{
+    if (Texture* t = BoundTexture(target))
+        Upload(*t, level, x, y, 0, w, h, 1, SliceOf(target), 0, 0, data, true, size);
+}
+
+void gl_CompressedTexSubImage3D(GLenum target, GLint level, GLint x, GLint y, GLint z, GLsizei w, GLsizei h,
+    GLsizei d, GLenum, GLsizei size, const void* data)
+{
+    Texture* t = BoundTexture(target);
+    if (!t)
+        return;
+    if (target == GL_TEXTURE_3D)
+        Upload(*t, level, x, y, z, w, h, d, 0, 0, 0, data, true, size);
+    else
+    {
+        const GLsizei layer = d > 0 ? size / d : size;
+        for (GLsizei i = 0; i < d; ++i)
+            Upload(*t, level, x, y, 0, w, h, 1, NSUInteger(z + i), 0, 0, static_cast<const uint8_t*>(data) + layer * i,
+                true, layer);
+    }
+}
+
+void SetParam(SamplerParams& p, GLenum pname, float v)
+{
+    const auto i = int32_t(v);
+    switch (pname)
+    {
+    case GL_TEXTURE_MIN_FILTER: p.minF = i; break;
+    case GL_TEXTURE_MAG_FILTER: p.magF = i; break;
+    case GL_TEXTURE_WRAP_S: p.wrapS = i; break;
+    case GL_TEXTURE_WRAP_T: p.wrapT = i; break;
+    case GL_TEXTURE_WRAP_R: p.wrapR = i; break;
+    case GL_TEXTURE_COMPARE_MODE: p.compareMode = i; break;
+    case GL_TEXTURE_COMPARE_FUNC: p.compareFunc = i; break;
+    case GL_TEXTURE_MAX_ANISOTROPY: p.maxAniso = std::max(1, i); break;
+    case GL_TEXTURE_MAX_LEVEL: p.maxLevel = i; break;
+    case GL_TEXTURE_MIN_LOD: p.minLod = v; break;
+    case GL_TEXTURE_MAX_LOD: p.maxLod = v; break;
+    default: break;
+    }
+}
+
+void gl_TexParameteri(GLenum target, GLenum pname, GLint v)
+{
+    if (Texture* t = BoundTexture(target))
+        SetParam(t->params, pname, float(v));
+}
+void gl_TexParameterf(GLenum target, GLenum pname, GLfloat v)
+{
+    if (Texture* t = BoundTexture(target))
+        SetParam(t->params, pname, v);
+}
+void gl_TexParameteriv(GLenum target, GLenum pname, const GLint* v)
+{
+    if (v)
+        gl_TexParameteri(target, pname, v[0]);
+}
+
+void gl_GetTexLevelParameteriv(GLenum target, GLint level, GLenum pname, GLint* v)
+{
+    const Texture* t = BoundTexture(target);
+    *v = 0;
+    if (!t)
+        return;
+    switch (pname)
+    {
+    case GL_TEXTURE_WIDTH: *v = std::max(1, t->w >> level); break;
+    case GL_TEXTURE_HEIGHT: *v = std::max(1, t->h >> level); break;
+    case GL_TEXTURE_DEPTH: *v = std::max(1, t->d >> (t->target == GL_TEXTURE_3D ? level : 0)); break;
+    case GL_TEXTURE_INTERNAL_FORMAT: *v = GLint(t->internal); break;
+    default: break;
+    }
+}
+
+void gl_PixelStorei(GLenum pname, GLint v)
+{
+    if (pname == GL_UNPACK_ALIGNMENT && v > 0)
+        s.unpackAlignment = v;
+}
+
+// --- объекты-сэмплеры --------------------------------------------------------------
+void gl_DeleteSamplers(GLsizei n, const GLuint* ids)
+{
+    for (GLsizei i = 0; i < n; ++i)
+        s.samplers.erase(ids[i]);
+}
+void gl_BindSampler(GLuint unit, GLuint sampler)
+{
+    if (unit < kMaxUnits)
+        s.unitSampler[unit] = sampler;
+}
+void gl_SamplerParameteri(GLuint sm, GLenum pname, GLint v) { SetParam(s.samplers[sm], pname, float(v)); }
+void gl_SamplerParameterf(GLuint sm, GLenum pname, GLfloat v) { SetParam(s.samplers[sm], pname, v); }
+void gl_SamplerParameteriv(GLuint sm, GLenum pname, const GLint* v)
+{
+    if (v)
+        SetParam(s.samplers[sm], pname, float(v[0]));
+}
+void gl_SamplerParameterIuiv(GLuint, GLenum, const GLuint*) {} // цвет границы: на A10 нет
+void gl_GetSamplerParameteriv(GLuint sm, GLenum pname, GLint* v)
+{
+    const SamplerParams& p = s.samplers[sm];
+    switch (pname)
+    {
+    case GL_TEXTURE_MIN_FILTER: *v = p.minF; break;
+    case GL_TEXTURE_MAG_FILTER: *v = p.magF; break;
+    default: *v = 0; break;
+    }
+}
+
+MTLSamplerAddressMode AddressOf(int32_t wrap)
+{
+    switch (wrap)
+    {
+    case GL_CLAMP_TO_EDGE: return MTLSamplerAddressModeClampToEdge;
+    case GL_MIRRORED_REPEAT: return MTLSamplerAddressModeMirrorRepeat;
+    case GL_CLAMP_TO_BORDER: return MTLSamplerAddressModeClampToEdge; // нет на A10
+    default: return MTLSamplerAddressModeRepeat;
+    }
+}
+
+MTLCompareFunction CompareOf(GLenum f)
+{
+    switch (f)
+    {
+    case GL_NEVER: return MTLCompareFunctionNever;
+    case GL_LESS: return MTLCompareFunctionLess;
+    case GL_EQUAL: return MTLCompareFunctionEqual;
+    case GL_LEQUAL: return MTLCompareFunctionLessEqual;
+    case GL_GREATER: return MTLCompareFunctionGreater;
+    case GL_NOTEQUAL: return MTLCompareFunctionNotEqual;
+    case GL_GEQUAL: return MTLCompareFunctionGreaterEqual;
+    default: return MTLCompareFunctionAlways;
+    }
+}
+
+id<MTLSamplerState> SamplerStateOf(const SamplerParams& p, int textureLevels)
+{
+    SamplerParams key = p;
+    // без мипов выборка из мипов бессмысленна (и в GL такая текстура «неполная»)
+    if (textureLevels <= 1)
+        key.maxLevel = 0;
+    const auto it = s.samplerStates.find(key);
+    if (it != s.samplerStates.end())
+        return it->second;
+    MTLSamplerDescriptor* d = [MTLSamplerDescriptor new];
+    const bool linearMin = key.minF == GL_LINEAR || key.minF == GL_LINEAR_MIPMAP_NEAREST
+        || key.minF == GL_LINEAR_MIPMAP_LINEAR;
+    d.minFilter = linearMin ? MTLSamplerMinMagFilterLinear : MTLSamplerMinMagFilterNearest;
+    d.magFilter = key.magF == GL_NEAREST ? MTLSamplerMinMagFilterNearest : MTLSamplerMinMagFilterLinear;
+    if (key.maxLevel == 0 || key.minF == GL_NEAREST || key.minF == GL_LINEAR)
+        d.mipFilter = MTLSamplerMipFilterNotMipmapped;
+    else if (key.minF == GL_NEAREST_MIPMAP_NEAREST || key.minF == GL_LINEAR_MIPMAP_NEAREST)
+        d.mipFilter = MTLSamplerMipFilterNearest;
+    else
+        d.mipFilter = MTLSamplerMipFilterLinear;
+    d.sAddressMode = AddressOf(key.wrapS);
+    d.tAddressMode = AddressOf(key.wrapT);
+    d.rAddressMode = AddressOf(key.wrapR);
+    d.maxAnisotropy = NSUInteger(std::clamp(key.maxAniso, 1, 16));
+    d.lodMinClamp = std::max(0.f, key.minLod);
+    d.lodMaxClamp = std::min(key.maxLod, float(key.maxLevel));
+    if (d.lodMaxClamp < d.lodMinClamp)
+        d.lodMaxClamp = d.lodMinClamp;
+    if (key.compareMode == GL_COMPARE_REF_TO_TEXTURE)
+        d.compareFunction = CompareOf(GLenum(key.compareFunc));
+    id<MTLSamplerState> st = [core.device newSamplerStateWithDescriptor:d];
+    s.samplerStates[key] = st;
+    return st;
+}
+
+// --- кадровые буферы и рендербуферы -------------------------------------------------
+void gl_BindFramebuffer(GLenum target, GLuint fb)
+{
+    if (target == GL_FRAMEBUFFER || target == GL_DRAW_FRAMEBUFFER)
+        s.drawFbo = fb;
+    if (target == GL_FRAMEBUFFER || target == GL_READ_FRAMEBUFFER)
+        s.readFbo = fb;
+}
+
+void gl_DeleteFramebuffers(GLsizei n, const GLuint* ids)
+{
+    for (GLsizei i = 0; i < n; ++i)
+        s.fbos.erase(ids[i]);
+}
+
+Fbo* TargetFbo(GLenum target)
+{
+    const GLuint name = target == GL_READ_FRAMEBUFFER ? s.readFbo : s.drawFbo;
+    return name ? &s.fbos[name] : nullptr;
+}
+
+void Attach(GLenum target, GLenum attachment, GLuint tex, GLint level)
+{
+    Fbo* f = TargetFbo(target);
+    if (!f)
+        return;
+    if (attachment >= GL_COLOR_ATTACHMENT0 && attachment < GL_COLOR_ATTACHMENT0 + kMaxColor)
+    {
+        f->color[attachment - GL_COLOR_ATTACHMENT0] = tex;
+        f->colorLevel[attachment - GL_COLOR_ATTACHMENT0] = level;
+    }
+    else if (attachment == GL_DEPTH_ATTACHMENT)
+        f->depth = tex;
+    else if (attachment == GL_STENCIL_ATTACHMENT)
+        f->stencil = tex;
+    else if (attachment == GL_DEPTH_STENCIL_ATTACHMENT)
+        f->depth = f->stencil = tex;
+}
+
+void gl_FramebufferTexture2D(GLenum target, GLenum attachment, GLenum, GLuint tex, GLint level)
+{
+    Attach(target, attachment, tex, level);
+}
+
+// рендербуферы храним в тех же текстурах (с флагом в старшем бите имени не нужно —
+// имена у нас общие на все объекты)
+void gl_BindRenderbuffer(GLenum, GLuint rb) { s.renderbuffer = rb; }
+void gl_RenderbufferStorage(GLenum, GLenum internal, GLsizei w, GLsizei h)
+{
+    if (!s.renderbuffer)
+        return;
+    Texture& t = s.textures[s.renderbuffer];
+    Allocate(t, GL_TEXTURE_2D, 1, internal, w, h, 1);
+}
+void gl_RenderbufferStorageMultisample(GLenum target, GLsizei, GLenum internal, GLsizei w, GLsizei h)
+{
+    gl_RenderbufferStorage(target, internal, w, h);
+}
+void gl_FramebufferRenderbuffer(GLenum target, GLenum attachment, GLenum, GLuint rb) { Attach(target, attachment, rb, 0); }
+
+void gl_DrawBuffers(GLsizei n, const GLenum* bufs)
+{
+    Fbo* f = TargetFbo(GL_DRAW_FRAMEBUFFER);
+    if (!f)
+        return;
+    for (int i = 0; i < kMaxColor; ++i)
+        f->drawBuffers[i] = i < n ? bufs[i] : GL_NONE;
+}
+
+id<MTLTexture> TexOf(GLuint name)
+{
+    const auto it = s.textures.find(name);
+    return it == s.textures.end() ? nil : it->second.mtl;
+}
+
+// --- кадр и проходы -------------------------------------------------------------------
+void BeginFrameIfNeeded()
+{
+    if (s.cmd)
+        return;
+    dispatch_semaphore_wait(s.inFlight, DISPATCH_TIME_FOREVER);
+    auto& ring = s.rings[s.frameIndex % kFramesInFlight];
+    ring.chunk = 0;
+    ring.offset = 0;
+    s.cmd = [core.queue commandBuffer];
+}
+
+struct Alloc
+{
+    id<MTLBuffer> buffer;
+    NSUInteger offset;
+    uint8_t* ptr;
+};
+
+Alloc Transient(size_t size, size_t align = 256)
+{
+    BeginFrameIfNeeded();
+    auto& ring = s.rings[s.frameIndex % kFramesInFlight];
+    constexpr size_t kChunk = 1 << 20;
+    for (;;)
+    {
+        if (ring.chunk >= ring.chunks.size())
+            ring.chunks.push_back([core.device newBufferWithLength:std::max(kChunk, size)
+                                                           options:MTLResourceStorageModeShared]);
+        id<MTLBuffer> b = ring.chunks[ring.chunk];
+        const size_t off = (ring.offset + align - 1) / align * align;
+        if (off + size <= b.length)
+        {
+            ring.offset = off + size;
+            return { b, NSUInteger(off), static_cast<uint8_t*>(b.contents) + off };
+        }
+        ++ring.chunk;
+        ring.offset = 0;
+    }
+}
+
+void EndEncoder()
+{
+    if (s.enc)
+    {
+        [s.enc endEncoding];
+        s.enc = nil;
+        s.encKey.clear();
+    }
+}
+
+struct PassTargets
+{
+    id<MTLTexture> color[kMaxColor] = {};
+    NSUInteger colorLevel[kMaxColor] = {};
+    id<MTLTexture> depth = nil;
+    id<MTLTexture> stencil = nil;
+    std::string key;
+    bool empty = true;
+    int width = 0, height = 0;
+};
+
+PassTargets CurrentTargets()
+{
+    PassTargets t;
+    char buf[64];
+    if (!s.drawFbo)
+        return t;
+    const Fbo& f = s.fbos[s.drawFbo];
+    for (int i = 0; i < kMaxColor; ++i)
+    {
+        const GLenum db = f.drawBuffers[i];
+        if (db < GL_COLOR_ATTACHMENT0 || db >= GL_COLOR_ATTACHMENT0 + kMaxColor)
+            continue;
+        const int a = int(db - GL_COLOR_ATTACHMENT0);
+        t.color[i] = TexOf(f.color[a]);
+        t.colorLevel[i] = NSUInteger(f.colorLevel[a]);
+    }
+    t.depth = TexOf(f.depth);
+    if (t.depth && !IsDepth(t.depth.pixelFormat))
+        t.depth = nil;
+    if (t.depth && HasStencil(t.depth.pixelFormat))
+        t.stencil = t.depth;
+    else if (f.stencil && f.stencil != f.depth)
+    {
+        id<MTLTexture> st = TexOf(f.stencil);
+        if (st && HasStencil(st.pixelFormat))
+            t.stencil = st;
+    }
+    for (int i = 0; i < kMaxColor; ++i)
+    {
+        snprintf(buf, sizeof(buf), "%p:%u|", (__bridge void*)t.color[i], unsigned(t.colorLevel[i]));
+        t.key += buf;
+        if (t.color[i] && t.empty)
+        {
+            t.empty = false;
+            t.width = int(std::max<NSUInteger>(1, t.color[i].width >> t.colorLevel[i]));
+            t.height = int(std::max<NSUInteger>(1, t.color[i].height >> t.colorLevel[i]));
+        }
+    }
+    snprintf(buf, sizeof(buf), "%p|%p", (__bridge void*)t.depth, (__bridge void*)t.stencil);
+    t.key += buf;
+    if (t.empty && (t.depth || t.stencil))
+    {
+        t.empty = false;
+        id<MTLTexture> d = t.depth ? t.depth : t.stencil;
+        t.width = int(d.width);
+        t.height = int(d.height);
+    }
+    return t;
+}
+
+// Начать проход: clearMask — какие вложения очистить (иначе загрузить)
+void BeginPass(const PassTargets& t, GLbitfield clearMask)
+{
+    BeginFrameIfNeeded();
+    EndEncoder();
+    MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+    for (int i = 0; i < kMaxColor; ++i)
+    {
+        if (!t.color[i])
+            continue;
+        rp.colorAttachments[i].texture = t.color[i];
+        rp.colorAttachments[i].level = t.colorLevel[i];
+        rp.colorAttachments[i].loadAction = (clearMask & GL_COLOR_BUFFER_BIT) ? MTLLoadActionClear : MTLLoadActionLoad;
+        rp.colorAttachments[i].storeAction = MTLStoreActionStore;
+        rp.colorAttachments[i].clearColor = MTLClearColorMake(s.clearColor[0], s.clearColor[1], s.clearColor[2],
+            s.clearColor[3]);
+    }
+    if (t.depth)
+    {
+        rp.depthAttachment.texture = t.depth;
+        rp.depthAttachment.loadAction = (clearMask & GL_DEPTH_BUFFER_BIT) ? MTLLoadActionClear : MTLLoadActionLoad;
+        rp.depthAttachment.storeAction = MTLStoreActionStore;
+        rp.depthAttachment.clearDepth = s.clearDepth;
+    }
+    if (t.stencil)
+    {
+        rp.stencilAttachment.texture = t.stencil;
+        rp.stencilAttachment.loadAction = (clearMask & GL_STENCIL_BUFFER_BIT) ? MTLLoadActionClear : MTLLoadActionLoad;
+        rp.stencilAttachment.storeAction = MTLStoreActionStore;
+        rp.stencilAttachment.clearStencil = uint32_t(s.clearStencil);
+    }
+    s.enc = [s.cmd renderCommandEncoderWithDescriptor:rp];
+    s.encKey = t.key;
+    for (int i = 0; i < kMaxColor; ++i)
+        s.encColor[i] = t.color[i];
+    s.encDepth = t.depth;
+    ++s.passes;
+}
