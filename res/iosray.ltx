; iOSRay: настройки графики для телефона.
; Применяются при каждом запуске ПОСЛЕ user.ltx, поэтому перекрывают меню.
; Файл можно править прямо в «Файлах» (папка soc). Строку можно отключить,
; поставив в начало «;». Удалите файл — iOSRay положит исходный при следующем запуске.

; тени от солнца: размер карты (1024 — быстро, 2048 — чётче)
r2_smap_size 1024
r2_sun_quality st_opt_low

; затенение углов (SSAO) — очень дорогое на телефоне
r2_ssao st_opt_off

; объёмный свет, мягкие частицы/вода, рельеф, мокрые поверхности, дым
r2_volumetric_lights off
r2_soft_particles off
r2_soft_water off
r2_steep_parallax off
r3_dynamic_wet_surfaces off
r3_volumetric_smoke off
r2_dof_enable off
r2_mblur 0

; трава: радиус и плотность (больше density — реже трава)
r__detail_radius 49
r__detail_density 0.8

; дальность прорисовки (1.0 — как в игре)
rs_vis_distance 0.8
